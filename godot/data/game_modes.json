      "GetNumRoundsFromSetting": "float setting -> int: 0.0=>1, 1.0=>2, 2.0=>3, else=>4 (compared with vcmp #0 / vldr 1.0 / vldr 2.0; literals 0x1fecd4=1.0, 0x1fecd8=2.0)",
      "GetTimeFromSetting": "float setting -> int seconds: 0.0=>30, 1.0=>60, 2.0=>90, 3.0=>0, else=>60 (0 means no timer / infinite countdown)",
      "FightBaseScore": "score = 100 + 25 * trunc(GetTReal('arcade_difficulty')); disasm add r0,r0,r0,lsl#2 twice then add #0x64",
      "difficulty_encode": "difficulty_byte = trunc(2 * setting); easy(0)=>0, medium(1)=>2, hard(2)=>4; stored at TMatchConfig+0xf8 (= TFighterConfig[slot 1]+0x54), read by CDecisionTree::MakeDecision as params_by_difficulty slot"
    }
