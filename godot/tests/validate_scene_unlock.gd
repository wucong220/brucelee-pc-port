extends SceneTree
## Headless validation of the recovered scenery-unlock gate
## (`BRUCELEE_SCENE_UNLOCK`, on unless "0").
##
## It boots the real `PrototypeMenu` (the same node `main.tscn` creates) and
## asserts, against fixtures generated by `tools/make_scene_unlock_fixtures.py`:
##
##   * the ten `sceneries.list` rows map to the nine story-event unlock ids the
##     decoded `unlocks.list` carries (item 1..9 -> 85/79/84/82/87/80/83/86/81)
##     and to the recovered `port_scene_variant` commands;
##   * no save / empty save / corrupted save / missing unlock table / a scenery
##     id with no recovered grant / a save whose EXP is maxed but which has no
##     story-event scenery grant -> the gated rows stay LOCKED (fail closed);
##   * a partial save opens exactly its granted rows, a full save opens all ten,
##     an out-of-range saved id grants nothing;
##   * the text SCENES submenu shows the recovered labels with the port-chrome
##     `(LOCKED)` suffix on exactly the closed rows, refuses to emit a command
##     for them, and still emits for an open row;
##   * the recovered dock draws the decoded `lockedpicture` for closed cards,
##     refuses to confirm them, and draws the scene icons for open cards;
##   * the gate re-reads the save every time the scene submenu opens;
##   * BRUCELEE_SCENE_UNLOCK=0 restores the ungated menu for both paths.
##
## Usage:
##   godot --headless --path <project> --script res://tests/validate_scene_unlock.gd \
##         --quit-after 60000 -- <fixtures-dir>

const PrototypeMenu = preload("res://scripts/prototype_menu.gd")
const Gate = preload("res://scripts/scene_unlock_gate.gd")
const ProgressServiceScript = preload("res://scripts/progress_service.gd")

const LOCKED_SUFFIX := " (LOCKED)"
const LOCKED_ICON := "bl_scenelocked_icon"
const CROP := Rect2(0, 0, 165, 114)

## Recovered row -> grant mapping, recorded independently of the data files:
## [name, command, always_available, unlock_id].
const EXPECTED := [
	["market", "squarea", true, -1],
	["market b", "squareb", false, 85],
	["temple yard", "temple_a", false, 79],
	["temple yard b", "temple_b", false, 84],
	["harbour", "harboura", false, 82],
	["harbour b", "harbourb", false, 87],
	["tournament hall", "halla", false, 80],
	["tournament hall b", "tournamenthallb", false, 83],
	["rooftops", "rooftopsa", false, 86],
	["rooftops b", "rooftopsb", false, 81],
]

var passed: int = 0
var failed: int = 0
var commands: Array = []
var fixtures: String = ""


func _initialize() -> void:
	call_deferred("_run")


# ------------------------------------------------------------------ helpers

func _check(condition: bool, description: String) -> bool:
	if condition:
		passed += 1
		print("PASS " + description)
	else:
		failed += 1
		printerr("FAIL " + description)
	return condition


func _key(keycode: Key) -> InputEventKey:
	var event: InputEventKey = InputEventKey.new()
	event.keycode = keycode
	event.pressed = true
	return event


func _frames(count: int) -> void:
	for _index: int in range(count):
		await process_frame


func _on_command(command: String) -> void:
	commands.append(command)


func _fixture(name: String) -> String:
	return fixtures.path_join(name)


func _missing_save() -> String:
	return _fixture("save_does_not_exist.json")


func _env(scene_select: String, save: String, unlocks: String = "",
		unlock_flag: String = "", story: String = "") -> void:
	## unlock_flag "" keeps the gate on (default); "0" turns it off.
	for name: String in [
		"BRUCELEE_STORY_FLOW", "BRUCELEE_STORY_LAUNCH", "BRUCELEE_GAME_MODE",
		"BRUCELEE_MODE_LAUNCH", "BRUCELEE_ATTRACT", "BRUCELEE_CONTINUE",
		"BRUCELEE_PROGRESS", "BRUCELEE_STYLE_EDITOR", "BRUCELEE_SCENE",
		"BRUCELEE_SCENE_SELECT_LAYOUT", "BRUCELEE_SCENE_SELECT_ART",
		"BRUCELEE_ROUND_INTRO", "BRUCELEE_MENU_ART",
	]:
		OS.set_environment(name, "")
	OS.set_environment("BRUCELEE_MAIN_MENU", "1")
	OS.set_environment("BRUCELEE_SCENE_SELECT", scene_select)
	OS.set_environment("BRUCELEE_SCENE_UNLOCK", unlock_flag)
	OS.set_environment("BRUCELEE_SCENE_UNLOCK_SAVE", save)
	OS.set_environment("BRUCELEE_SCENE_UNLOCK_UNLOCKS", unlocks)
	OS.set_environment("BRUCELEE_SCENE_UNLOCK_STORY", story)
	OS.set_environment("BRUCELEE_LANG", "en")


func _new_gate(save: String, unlocks: String = "", story: String = "") -> Object:
	_env("", save, unlocks, "", story)
	var gate = Gate.new()
	gate.refresh()
	return gate


func _new_menu(scene_select: String, save: String, unlocks: String = "",
		unlock_flag: String = "", story: String = "") -> Node:
	_env(scene_select, save, unlocks, unlock_flag, story)
	var menu: Node = PrototypeMenu.new()
	root.add_child(menu)
	await _frames(2)
	menu.command_requested.connect(_on_command)
	return menu


func _free_menu(menu: Node) -> void:
	menu.queue_free()
	await _frames(2)


func _text_of(item: Dictionary) -> String:
	return String(item.get("text", ""))


func _row_texts(menu: Node) -> Array:
	var out: Array = []
	for item: Dictionary in (menu.layout_report()["items"] as Array):
		out.append(_text_of(item))
	return out


func _count_locked_text(menu: Node) -> int:
	var total: int = 0
	for text: String in _row_texts(menu):
		if text.ends_with(LOCKED_SUFFIX):
			total += 1
	return total


func _all_crops(regions: Array) -> bool:
	if regions.size() != 10:
		return false
	for region: Variant in regions:
		if not (region as Rect2).is_equal_approx(CROP):
			return false
	return true


# --------------------------------------------------------------------- run

func _run() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	if args.size() < 1:
		printerr("expected <fixtures-dir>")
		quit(1)
		return
	fixtures = args[0]
	preload("res://scripts/prototype_controls.gd").ensure_default_actions()
	await _check_row_mapping()
	await _check_save_states()
	await _check_progress_chain()
	await _check_text_menu()
	await _check_dock()
	_finish()


func _finish() -> void:
	var total: int = passed + failed
	print("SCENE_UNLOCK_VALIDATION_RESULT=%s checks=%d passed=%d failed=%d" % [
		"PASS" if failed == 0 else "FAIL", total, passed, failed])
	quit(0 if failed == 0 else 1)


# ------------------------------------------------------- row / grant mapping

func _check_row_mapping() -> void:
	var gate = _new_gate(_missing_save())
	_check(gate.rows.size() == 10, "the gate exposes the ten sceneries.list rows")
	if gate.rows.size() != 10:
		return
	for index: int in range(EXPECTED.size()):
		var expected: Array = EXPECTED[index]
		var state: Dictionary = gate.state_for_index(index)
		_check(String(state.get("name", "")) == String(expected[0]),
			"row %d keeps the sceneries.list name '%s'" % [index, String(expected[0])])
		_check(String(state.get("command", "")) == String(expected[1]),
			"row %d maps to the existing scene command '%s'" % [index, String(expected[1])])
		_check(bool(state.get("always_available", false)) == bool(expected[2]),
			"row %d keeps the decoded always_available=%s" % [index, str(expected[2])])
		if index == 0:
			_check(int(state.get("unlock_id", -2)) == -1,
				"row 0 is the always-available row and carries no grant id")
		else:
			_check(int(state.get("unlock_id", -1)) == int(expected[3]),
				"row %d maps to its recovered story-event unlock id %d"
					% [index, int(expected[3])])
	var state5: Dictionary = gate.state_for_index(5)
	_check(String(state5.get("unlock_source", "")) == "chapter5/s_changes",
		"row 5 records the decoded granting event chapter5/s_changes")
	_check(gate.data_ok, "the decoded sceneries/unlock_item_names tables loaded")
	_check(gate.registry_ok, "the decoded unlock registry loaded")


# ------------------------------------------------------------- save states

func _check_save_states() -> void:
	var no_save = _new_gate(_missing_save())
	_check(not bool(no_save.save_present), "no save: the file is reported absent")
	_check(int(no_save.locked_count()) == 9, "no save: the nine gated rows are locked")
	_check(bool(no_save.state_for_index(0).get("available", false)),
		"no save: the always_available row stays open (decoded flag)")
	_check(String(no_save.state_for_index(0).get("reason", "")) == "always_available",
		"no save: row 0 reason is always_available")
	var no_save_reasons: Array = []
	for index: int in range(1, 10):
		no_save_reasons.append(String(no_save.state_for_index(index).get("reason", "")))
	_check(no_save_reasons == ["no_save", "no_save", "no_save", "no_save", "no_save",
		"no_save", "no_save", "no_save", "no_save"],
		"no save: every gated row reports reason no_save")

	var empty = _new_gate(_fixture("save_empty.json"))
	_check(bool(empty.save_valid), "empty save: the checksummed envelope is accepted")
	_check(int(empty.locked_count()) == 9, "empty save: the nine gated rows are locked")
	_check(String(empty.state_for_index(3).get("reason", "")) == "locked",
		"empty save: a gated row reports reason locked")

	var partial = _new_gate(_fixture("save_partial.json"))
	var partial_open: Array = []
	for index: int in range(10):
		if bool(partial.state_for_index(index).get("available", false)):
			partial_open.append(index)
	_check(partial_open == [0, 3, 9],
		"partial save: exactly the market and the two granted sceneries are open (got %s)"
			% str(partial_open))
	_check(int(partial.state_for_index(3).get("unlock_id", -1)) == 84,
		"partial save: temple yard b is granted by unlock id 84")
	_check(String(partial.state_for_index(3).get("reason", "")) == "unlocked",
		"partial save: the granted row reports reason unlocked")
	_check(String(partial.state_for_index(4).get("reason", "")) == "locked",
		"partial save: an ungranted row stays locked")

	var full = _new_gate(_fixture("save_full.json"))
	_check(int(full.locked_count()) == 0, "full save: all ten sceneries are open")
	_check(int(full.unlocked_count()) == 10, "full save: unlocked_count is 10")

	var exp_only = _new_gate(_fixture("save_exp_only.json"))
	_check(int(exp_only.locked_count()) == 9,
		"EXP-only save: max story EXP alone never opens a gated scenery")

	var corrupt = _new_gate(_fixture("save_corrupt.json"))
	_check(bool(corrupt.save_present) and not bool(corrupt.save_valid),
		"corrupt save: the envelope is present but rejected (fail closed)")
	_check(String(corrupt.state_for_index(1).get("reason", "")) == "save_invalid",
		"corrupt save: a gated row reports reason save_invalid")
	_check(int(corrupt.locked_count()) == 9, "corrupt save: all nine gated rows stay locked")

	var no_registry = _new_gate(_fixture("save_full.json"), _fixture("no_such_unlocks.json"))
	_check(not bool(no_registry.registry_ok),
		"missing unlock table: the registry is reported unavailable")
	_check(String(no_registry.state_for_index(1).get("reason", "")) == "unlock_data_missing",
		"missing unlock table: a gated row reports reason unlock_data_missing")
	_check(int(no_registry.locked_count()) == 9,
		"missing unlock table: every gated row stays locked even with a full save")

	var no_data = _new_gate(_fixture("save_full.json"), "",
		_fixture("story_missing_sceneries.json"))
	_check((no_data.rows as Array).is_empty(),
		"missing sceneries table: the gate builds no row to trust")
	_check(not String(no_data.error).is_empty(),
		"missing sceneries table: the gate records the fail-closed cause")

	var unknown = _new_gate(_fixture("save_full.json"),
		_fixture("unlocks_missing_scenery_5.json"))
	_check(int(unknown.locked_count()) == 1,
		"unknown scenery id: only the scenery with no recovered grant is locked")
	_check(String(unknown.state_for_index(5).get("reason", "")) == "unknown_scenery_id",
		"unknown scenery id: row 5 reports reason unknown_scenery_id")
	_check(int(unknown.state_for_index(5).get("unlock_id", -2)) == -1,
		"unknown scenery id: row 5 exposes no invented grant id")
	_check(bool(unknown.state_for_index(4).get("available", false)),
		"unknown scenery id: its neighbours stay open from the same save")

	var none = _new_gate(_fixture("save_full.json"), _fixture("unlocks_no_scenery.json"))
	_check(int(none.locked_count()) == 9,
		"no scenery grants at all: every gated row stays locked")

	var unknown_id = _new_gate(_fixture("save_unknown_id.json"))
	_check(unknown_id.unknown_saved_ids == [500],
		"out-of-range saved id: it is surfaced as unknown, not treated as a grant")
	_check(int(unknown_id.locked_count()) == 0,
		"out-of-range saved id: the valid grants still open the ten rows")


# -------------------------------------------------------- progress chain

## The fixtures hand-write unlock ids; this section proves the real recovered
## ProgressService writes them: completing the decoded story event grants its
## authored scenery subevent, the checksummed save is written, and the gate reads
## that save and opens exactly that scenery row.
func _check_progress_chain() -> void:
	var service = ProgressServiceScript.new()
	_check(service != null, "progress chain: the recovered ProgressService loads")
	if service == null:
		return
	var path: String = ProjectSettings.globalize_path(
		"user://scene_unlock_gate_test_save.json")
	var fresh: Array = service.complete_story_event("chapter1", "s_master_6")
	_check(fresh.has(84),
		"progress chain: chapter1/s_master_6 grants scenery unlock id 84 (got %s)" % str(fresh))
	_check((service.state["unlocks"]["unlocked_ids"] as Array).has(84),
		"progress chain: the granted id is in the service's unlocked_ids")
	_check(service.save(path), "progress chain: the granted state is written as a save")
	var gate = _new_gate(path)
	_check(bool(gate.save_valid), "progress chain: the gate accepts the written save")
	_check(bool(gate.state_for_index(3).get("available", false)),
		"progress chain: the gate opens the granted scenery row (temple yard b)")
	_check(String(gate.state_for_index(3).get("reason", "")) == "unlocked",
		"progress chain: the opened row reports reason unlocked")
	_check(not bool(gate.state_for_index(4).get("available", true)),
		"progress chain: an ungranted row stays locked")

	var second: Array = service.complete_story_event("chapter2", "s_tiger_3")
	_check(second.has(85),
		"progress chain: chapter2/s_tiger_3 grants scenery unlock id 85")
	_check(service.save(path), "progress chain: the second grant is written to the save")
	gate.refresh()
	_check(bool(gate.state_for_index(1).get("available", false)),
		"progress chain: the reloaded gate opens the second granted scenery (market b)")
	_check(int(gate.locked_count()) == 7,
		"progress chain: only the two granted sceneries and the always-available row are open")
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(path)


# --------------------------------------------------------------- text menu

func _check_text_menu() -> void:
	commands.clear()
	var menu: Node = await _new_menu("", _missing_save())
	_check(menu.scene_gate != null, "text menu: the gate is on by default")
	menu.show_scene_menu()
	await _frames(1)
	_check(menu.menu_state == "scenes", "text menu: SCENES opens the text submenu")
	_check((menu.layout_report()["items"] as Array).size() == 11,
		"text menu: the submenu keeps its 11 rows (ten scenes + BACK)")
	_check(_count_locked_text(menu) == 9, "text menu: exactly nine rows carry (LOCKED)")
	var texts: Array = _row_texts(menu)
	_check(String(texts[0]) == "TEMPLE YARD A" + LOCKED_SUFFIX,
		"text menu: the localized recovered label keeps its text and adds (LOCKED)")
	_check(not String(texts[3]).ends_with(LOCKED_SUFFIX),
		"text menu: the always-available market row is not marked locked")
	# A locked row must not emit a scene command.
	_check(menu.selected_command() == "temple_a",
		"text menu: the submenu still starts on the first row")
	menu.handle_input_event(_key(KEY_ENTER))
	await _frames(1)
	_check(commands.is_empty(), "text menu: confirming a locked row emits no command")
	_check(String(menu.status_label.text) == "SCENE LOCKED",
		"text menu: confirming a locked row reports SCENE LOCKED")
	# The open market row still applies.
	for _step: int in range(3):
		menu.handle_input_event(_key(KEY_DOWN))
	await _frames(1)
	_check(menu.selected_command() == "squarea",
		"text menu: DOWN reaches the open market row (squarea)")
	menu.handle_input_event(_key(KEY_ENTER))
	await _frames(1)
	_check(commands == ["squarea"], "text menu: the open row still emits its scene command")
	await _free_menu(menu)

	commands.clear()
	var full_menu: Node = await _new_menu("", _fixture("save_full.json"))
	full_menu.show_scene_menu()
	await _frames(1)
	_check(_count_locked_text(full_menu) == 0, "text menu: a full save marks no row locked")
	full_menu.handle_input_event(_key(KEY_DOWN))
	full_menu.handle_input_event(_key(KEY_ENTER))
	await _frames(1)
	_check(commands == ["temple_b"],
		"text menu: with the saved grant the second row applies (temple_b)")
	await _free_menu(full_menu)

	commands.clear()
	var off_menu: Node = await _new_menu("", _missing_save(), "", "0")
	off_menu.show_scene_menu()
	await _frames(1)
	_check(off_menu.scene_gate == null, "BRUCELEE_SCENE_UNLOCK=0: no gate object is built")
	_check(_count_locked_text(off_menu) == 0,
		"BRUCELEE_SCENE_UNLOCK=0: the text rows are the pre-gating menu")
	off_menu.handle_input_event(_key(KEY_ENTER))
	await _frames(1)
	_check(commands == ["temple_a"],
		"BRUCELEE_SCENE_UNLOCK=0: the first row applies as before")
	await _free_menu(off_menu)

	var no_registry_menu: Node = await _new_menu("", _fixture("save_full.json"),
		_fixture("no_such_unlocks.json"))
	no_registry_menu.show_scene_menu()
	await _frames(1)
	_check(_count_locked_text(no_registry_menu) == 9,
		"text menu fail closed: a missing unlock table marks every gated row")
	await _free_menu(no_registry_menu)

	commands.clear()
	var no_data_menu: Node = await _new_menu("", _fixture("save_full.json"), "", "",
		_fixture("story_missing_sceneries.json"))
	no_data_menu.show_scene_menu()
	await _frames(1)
	_check(_count_locked_text(no_data_menu) == 10,
		"text menu fail closed: a missing sceneries table closes all ten scene rows")
	_check(String(no_data_menu.status_label.text) == "SCENE UNLOCK UNAVAILABLE",
		"text menu fail closed: the missing table is reported on screen")
	no_data_menu.handle_input_event(_key(KEY_ENTER))
	await _frames(1)
	_check(commands.is_empty(),
		"text menu fail closed: no scene command is emitted without the decoded table")
	await _free_menu(no_data_menu)


# --------------------------------------------------------------------- dock

func _check_dock() -> void:
	commands.clear()
	var menu: Node = await _new_menu("1", _missing_save())
	_check(menu.scene_dock != null,
		"dock: the recovered dock loads with the gate on (" + String(menu.scene_dock_error) + ")")
	if menu.scene_dock == null:
		await _free_menu(menu)
		return
	menu.show_scene_menu()
	await _frames(1)
	_check(menu.scene_dock_visible(), "dock: the recovered dock owns the scene submenu")
	_check((menu.scene_dock_rows() as Array).size() == 10,
		"dock: the ten recovered rows are still drawn")
	_check(menu.scene_dock_locked_rows() == [1, 2, 3, 4, 5, 6, 7, 8, 9],
		"dock: no save locks the nine gated cards (got %s)"
			% str(menu.scene_dock_locked_rows()))
	var sources: Array = menu.scene_dock_card_sources()
	_check(String(sources[0]) == "bl_scene01a_hw_icon",
		"dock: the always-available market card keeps its scene icon")
	var locked_drawn: bool = true
	for index: int in range(1, 10):
		if String(sources[index]) != LOCKED_ICON:
			locked_drawn = false
	_check(locked_drawn, "dock: every closed card draws the decoded lockedpicture")
	_check(_all_crops(menu.scene_dock_card_regions()),
		"dock: locked and open cards keep the decoded 165x114 option crop")
	# A locked card must not apply.
	for _step: int in range(3):
		menu.handle_input_event(_key(KEY_RIGHT))
	await _frames(1)
	_check(int(menu.scene_dock_selection()) == 3, "dock: RIGHT reaches the fourth card")
	menu.handle_input_event(_key(KEY_ENTER))
	await _frames(2)
	_check(commands.is_empty(), "dock: confirming a locked card emits no command")
	_check(String(menu.scene_dock.hint_text()) == "SCENE LOCKED",
		"dock: confirming a locked card shows SCENE LOCKED")
	# The open market card still applies.
	for _step: int in range(3):
		menu.handle_input_event(_key(KEY_LEFT))
	await _frames(1)
	menu.handle_input_event(_key(KEY_ENTER))
	await _frames(2)
	_check(commands == ["squarea"], "dock: the open market card still emits squarea")
	await _free_menu(menu)

	commands.clear()
	var partial: Node = await _new_menu("1", _fixture("save_partial.json"))
	partial.show_scene_menu()
	await _frames(1)
	_check(partial.scene_dock_locked_rows() == [1, 2, 4, 5, 6, 7, 8],
		"dock: a partial save closes exactly the ungranted cards (got %s)"
			% str(partial.scene_dock_locked_rows()))
	var partial_sources: Array = partial.scene_dock_card_sources()
	_check(String(partial_sources[3]) == "bl_scene02b_hw_icon",
		"dock: the granted temple-yard-dusk card draws its scene icon")
	_check(String(partial_sources[9]) == "bl_scene05b_hw_icon",
		"dock: the granted rooftops-dusk card draws its scene icon")
	_check(String(partial_sources[4]) == LOCKED_ICON,
		"dock: an ungranted neighbour still draws the lockedpicture")
	for _step: int in range(3):
		partial.handle_input_event(_key(KEY_RIGHT))
	partial.handle_input_event(_key(KEY_ENTER))
	await _frames(2)
	_check(commands == ["temple_b"],
		"dock: a granted card applies its existing scene command (temple_b)")
	await _free_menu(partial)

	commands.clear()
	var full: Node = await _new_menu("1", _fixture("save_full.json"))
	full.show_scene_menu()
	await _frames(1)
	_check((full.scene_dock_locked_rows() as Array).is_empty(),
		"dock: a full save locks no card")
	var full_sources: Array = full.scene_dock_card_sources()
	_check(String(full_sources[7]) == "bl_scene04b_hw_icon",
		"dock: with all grants every card draws its own scene icon")
	for _step: int in range(3):
		full.handle_input_event(_key(KEY_RIGHT))
	full.handle_input_event(_key(KEY_ENTER))
	await _frames(2)
	_check(commands == ["temple_b"], "dock: a full save applies temple_b from card 3")
	await _free_menu(full)

	# The save is re-read whenever the submenu opens.
	var reload: Node = await _new_menu("1", _fixture("save_partial.json"))
	reload.show_scene_menu()
	await _frames(1)
	_check((reload.scene_dock_locked_rows() as Array).size() == 7,
		"dock reload: the partial save closes seven cards (ten minus market and the two grants)")
	OS.set_environment("BRUCELEE_SCENE_UNLOCK_SAVE", _fixture("save_full.json"))
	reload.show_scene_menu()
	await _frames(1)
	_check((reload.scene_dock_locked_rows() as Array).is_empty(),
		"dock reload: reopening the submenu picks up the new save without restarting")
	await _free_menu(reload)

	commands.clear()
	var unknown: Node = await _new_menu("1", _fixture("save_full.json"),
