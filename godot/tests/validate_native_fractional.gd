extends SceneTree
## Headless validation of the recovered fractional BuildFrame/GetOutput math.
##
##   godot --headless --path <isolated-project> \
##     --script res://tests/validate_native_fractional.gd --quit-after 900
##
## Oracle is generated by tools/make_fixtures.py from REAL .anm files and the
## proven Python implementation (float32). Fixtures carry the raw stored keys;
## this test checks the GDScript port decodes them natively (no GLB shortcuts).

const AnmTrackCodecScript = preload("res://scripts/anm_track_codec.gd")
const NativeRootOutputScript = preload("res://scripts/native_root_output.gd")
const RootEvaluator = preload("res://scripts/root_track_evaluator.gd")
const SampleMath = preload("res://scripts/replay_sample_math.gd")

const FIXTURES: String = "res://tests/data/anm_fixtures.json"
const ORACLE: String = "res://tests/data/fractional_oracle.json"

var passed: int = 0
var failures: Array[String] = []
var clips: Dictionary = {}


func _initialize() -> void:
    _load_data()
    _check_oracle()
    _check_synthetic()
    _check_fail_closed()
    _check_evaluator()
    _check_sample_math_integration()
    if failures.is_empty():
        print("NATIVE_FRACTIONAL_VALIDATION=PASS pass=%d" % passed)
        quit(0)
    else:
        for failure in failures:
            push_error("FRACTIONAL_FAIL " + failure)
        print("NATIVE_FRACTIONAL_VALIDATION=FAIL pass=%d fail=%d" % [passed, failures.size()])
        quit(1)


func _expect(condition: bool, label: String) -> void:
    if condition:
        passed += 1
    else:
        failures.append(label)


func _close(a: float, b: float, label: String, tol: float = 0.000002) -> void:
    _expect(absf(a - b) <= tol, "%s (got %.9f expected %.9f)" % [label, a, b])


func _array_close(got: Array, expected: Array, label: String) -> void:
    if got.size() != expected.size():
        _expect(false, "%s size %d != %d" % [label, got.size(), expected.size()])
        return
    for i in got.size():
        _close(float(got[i]), float(expected[i]), "%s[%d]" % [label, i])


func _json(path: String) -> Variant:
    return JSON.parse_string(FileAccess.get_file_as_string(path))


func _load_data() -> void:
    var fx: Variant = _json(FIXTURES)
    _expect(fx != null, "anm_fixtures.json parses")
    if fx == null:
        return
    for clip in fx["clips"]:
        clips[String(clip["name"])] = clip
    _expect(clips.size() >= 3, "three real ANM clips are present (got %d)" % clips.size())
    for name in ["m02_movefwd", "all_end_attack_01_forset01", "fx_bottle"]:
        _expect(clips.has(name), "real clip fixture: " + name)


func _check_oracle() -> void:
    var oracle: Variant = _json(ORACLE)
    _expect(oracle != null, "fractional_oracle.json parses")
    if oracle == null or clips.is_empty():
        return
    var cases: Array = oracle["cases"]
    _expect(cases.size() >= 20, "oracle has >= 20 real-data cases (got %d)" % cases.size())
    for case in cases:
        var name: String = String(case["clip"])
        if not clips.has(name):
            _expect(false, "oracle clip present: " + name)
            continue
        var out: Dictionary = NativeRootOutputScript.compose(clips[name], float(case["sample"]))
        _expect(bool(out["ok"]) == bool(case["ok"]),
            "case %s t=%s ok=%s" % [name, str(case["sample"]), str(case["ok"])])
        if not bool(case["ok"]):
            _expect(String(out.get("reason", "")) == String(case.get("reason", "")),
                "case %s t=%s fails closed with %s" % [name, str(case["sample"]), str(case.get("reason", ""))])
            continue
        _expect(String(out["mode"]) == String(case["mode"]),
            "case %s t=%s mode=%s" % [name, str(case["sample"]), str(case["mode"])])
        _array_close(out["position"], case["position"], "pos %s t=%s" % [name, str(case["sample"])])
        _array_close(out["rotation"], case["rotation"], "quat %s t=%s" % [name, str(case["sample"])])
        _array_close(out["scale"], case["scale"], "scale %s t=%s" % [name, str(case["sample"])])


func _check_synthetic() -> void:
    var oracle: Variant = _json(ORACLE)
    if oracle == null:
        return
    for s in oracle["synthetic"]:
        var kind: String = String(s["kind"])
        var codec: String = "rawfloatsample" if kind == "vec3_float" else "rawfixedsample"
        var tk: String = "quat" if kind.begins_with("quat") else "vec3"
        var track: Dictionary = {"codec": codec, "kind": tk, "keys": s["keys"], "static": false}
        var r: Dictionary = AnmTrackCodecScript.sample(track, float(s["sample"]))
        if s.has("expect_ok") and not bool(s["expect_ok"]):
            _expect(not bool(r["ok"]), "synthetic %s fails closed" % String(s["id"]))
            _expect(String(r.get("reason", "")) == String(s["reason"]),
                "synthetic %s reason" % String(s["id"]))
            continue
        _expect(bool(r["ok"]), "synthetic %s ok" % String(s["id"]))
        if not bool(r["ok"]):
            continue
        _expect(String(r["mode"]) == String(s["mode"]),
            "synthetic %s mode=%s" % [String(s["id"]), String(s["mode"])])
        _array_close(r["value"], s["expect"], "synthetic %s" % String(s["id"]))
        if s.has("expect_hemisphere_negated"):
            _expect(bool(r.get("hemisphere_negated", false)) == bool(s["expect_hemisphere_negated"]),
                "synthetic %s hemisphere flag" % String(s["id"]))
        if String(s["id"]) == "quat_fractional_normalised":
            var q: Array = r["value"]
            var norm: float = sqrt(float(q[0]) * float(q[0]) + float(q[1]) * float(q[1])
                + float(q[2]) * float(q[2]) + float(q[3]) * float(q[3]))
            _close(norm, 1.0, "fractional quaternion is nlerp-normalised")
        if String(s["id"]) == "quat_integer_unnormalised":
            var qi: Array = r["value"]
            var normi: float = sqrt(float(qi[0]) * float(qi[0]) + float(qi[1]) * float(qi[1])
                + float(qi[2]) * float(qi[2]) + float(qi[3]) * float(qi[3]))
            _expect(absf(normi - 1.0) > 0.2, "integer quaternion is NOT normalised (native)")


func _check_fail_closed() -> void:
    var e = RootEvaluator.new()
    _expect(not e.bind_anm({}), "empty ANM binding fails closed")
    _expect(e.last_error == "anm-clip-required", "empty binding reason")
    var bad: Dictionary = {"tracks": {"positions": {"codec": "waveletsample",
        "kind": "vec3", "keys": [[0, 0, 0]], "static": false}}}
    _expect(not e.bind_anm(bad), "wavelet root track fails closed")
    _expect(e.last_error.begins_with("unsupported-codec"), "wavelet reason")
    var no_pos: Dictionary = {"tracks": {"scales": null}}
    _expect(not e.bind_anm(no_pos), "missing positions fails closed")
    _expect(e.last_error == "missing-positions", "missing positions reason")
    # Out-of-range fractional sample must fail closed, not wrap or guess.
    var tiny: Dictionary = {"tracks": {"positions": {"codec": "rawfixedsample",
        "kind": "vec3", "keys": [[0, 0, 0], [4096, 0, 0]], "static": false}}}
    var r: Dictionary = NativeRootOutputScript.compose(tiny, 1.5)
    _expect(not bool(r["ok"]), "out-of-range fractional sample fails closed")
    _expect(String(r["reason"]) == "sample-out-of-range", "out-of-range reason")
    # Legacy Godot bridge: unchanged fail-closed behaviour without ANM binding.
    var ap := AnimationPlayer.new()
    var clip := Animation.new()
    var ti: int = clip.add_track(Animation.TYPE_POSITION_3D)
    clip.track_insert_key(ti, 0.0, Vector3.ZERO)
    clip.track_insert_key(ti, 1.0, Vector3.ONE)
    var lib := AnimationLibrary.new()
    lib.add_animation("dummy", clip)
    ap.add_animation_library("", lib)
    var legacy = RootEvaluator.new(ap)
    _expect(legacy.set_clip("dummy"), "legacy evaluator binds a Godot position track")
    _expect(not legacy.supports_fractional(), "unbound evaluator does NOT claim fractional support")
    _expect(legacy.root_position(0.5) == null, "unbound evaluator refuses fractional sample")
    _expect(legacy.last_error == "fractional-sample-unrecovered", "unbound evaluator reason")
    _expect(legacy.root_position(1.0) != null, "unbound evaluator still serves integer samples")
    ap.free()


func _check_evaluator() -> void:
    if clips.is_empty():
        return
    var e = RootEvaluator.new()
    _expect(e.bind_anm(clips["m02_movefwd"]), "evaluator binds the real ANM clip")
    _expect(e.supports_fractional(), "bound evaluator supports fractional samples")
    var v: Variant = e.root_position(0.5)
    _expect(v != null, "bound evaluator returns a fractional root position")
    if v != null:
        _close((v as Vector3).y, -4.5538330078125, "fractional root position y at 0.5")
    var t: Dictionary = e.root_transform(0.5)
    _expect(bool(t["ok"]) and String(t["mode"]) == "fractional",
        "root_transform returns proven fractional TTransform")
    var vi: Variant = e.root_position(1.0)
    _expect(vi != null, "bound evaluator returns an integer root position")
    if vi != null:
        _close((vi as Vector3).y, -9.107666015625, "integer root position y at 1.0")
    var bad: Variant = e.root_position(13.75)
    _expect(bad == null, "bound evaluator fails closed on out-of-range sample")
    _expect(e.last_error == "sample-out-of-range", "bound evaluator out-of-range reason")


func _check_sample_math_integration() -> void:
    if clips.is_empty():
        return
    var fx: Dictionary = clips["m02_movefwd"]
    var duration_samples: int = int(fx["headers"]["duration"])
    var duration_ms: int = int(fx["duration_ms"])
    _expect(duration_samples == 14 and duration_ms == 466,
        "real CAnimRes fields: duration=14, duration_ms=(14*1000)/30=466")
    var smooth: Dictionary = SampleMath.clip_fields(duration_samples, duration_ms, 1)
    var integer: Dictionary = SampleMath.clip_fields(duration_samples, duration_ms, 0)
    _expect(bool(smooth["ok"]) and bool(integer["ok"]), "clip fields recovered")
    var s5: Dictionary = SampleMath.set_to_sample(5.0, smooth)
    var i5: Dictionary = SampleMath.set_to_sample(5.0, integer)
    _expect(bool(s5["fractional"]), "smooth flag yields a fractional sample")
    _expect(not bool(i5["fractional"]), "integer flag floors the sample")
    _close(float(s5["sample_exact"]), 13.0 * (179.0 / 466.0),
        "smooth sample equals Nlast*clamp(c*time*|d|)", 0.0001)
    var out_s: Dictionary = NativeRootOutputScript.compose(fx, float(s5["sample_exact"]))
    var out_i: Dictionary = NativeRootOutputScript.compose(fx, float(i5["sample_exact"]))
    _expect(bool(out_s["ok"]) and String(out_s["mode"]) == "fractional",
        "fractional recovered sample composes a TTransform")
    _expect(bool(out_i["ok"]) and String(out_i["mode"]) == "integer",
        "integer recovered sample composes a TTransform")
    if bool(out_s["ok"]) and bool(out_i["ok"]):
        _expect(float(out_s["position"][1]) < float(out_i["position"][1]),
            "fractional sample differs from floored integer sample")
