extends RefCounted
class_name MenuLang
## Recovered `.lang` localization for the Arcade / Survival / Time Attack
## screens and the shared prototype menu.
##
## The data table (`res://data/lang/menu_lang.json`) is generated by
## `tools/build_lang_data.py` from the decoded 10-language `.lang` lookup:
## every value is copied verbatim from the game's own localization table.
##
## Contract:
##   * `text(key)` returns the recovered value for the active language.
##   * a key that is absent from the table is returned VERBATIM (`text("x")`
##     -> `"x"`).  No text is ever invented here.
##   * the active language comes from `BRUCELEE_LANG` (full `LangXxx` name or a
##     short alias); the default is `LangEnglish`.
##
## This helper only supplies display strings.  It never feeds game logic.

const DATA_PATH := "res://data/lang/menu_lang.json"
const ENV_LANG := "BRUCELEE_LANG"
const FALLBACK_LANGUAGE := "LangEnglish"

## Short identifiers accepted in BRUCELEE_LANG (identifiers, not display text).
const LANGUAGE_ALIASES := {
	"en": "LangEnglish", "english": "LangEnglish",
	"zh": "LangChineseSimpl", "zhs": "LangChineseSimpl",
	"zh-hans": "LangChineseSimpl", "zh_cn": "LangChineseSimpl",
	"zh-hant": "LangChineseTrad", "zht": "LangChineseTrad",
	"fr": "LangFrench", "french": "LangFrench",
	"de": "LangGerman", "german": "LangGerman",
	"it": "LangItalian", "italian": "LangItalian",
	"ja": "LangJapanese", "jp": "LangJapanese", "japanese": "LangJapanese",
	"ko": "LangKorean", "korean": "LangKorean",
	"ru": "LangRussian", "russian": "LangRussian",
	"es": "LangSpanish", "spanish": "LangSpanish",
}

## Per-language Windows font fallbacks so CJK values render instead of tofu.
const FONT_NAMES := {
	"LangChineseSimpl": ["Microsoft YaHei UI", "Microsoft YaHei", "SimSun", "Noto Sans CJK SC"],
	"LangChineseTrad": ["Microsoft JhengHei UI", "Microsoft JhengHei", "Microsoft YaHei", "SimSun"],
	"LangJapanese": ["Yu Gothic UI", "Yu Gothic", "Meiryo", "MS Gothic", "Microsoft YaHei"],
	"LangKorean": ["Malgun Gothic", "Gulim", "Microsoft YaHei"],
}

static var _data: Dictionary = {}
static var _loaded: bool = false
static var _language: String = ""
static var _fonts: Dictionary = {}


static func _ensure() -> bool:
	if _loaded:
		return not _data.is_empty()
	_loaded = true
	_data = {}
	if not FileAccess.file_exists(DATA_PATH):
		push_warning("MenuLang: missing " + DATA_PATH)
		return false
	var raw: String = FileAccess.get_file_as_string(DATA_PATH)
	if raw.is_empty():
		push_warning("MenuLang: empty " + DATA_PATH)
		return false
	var parsed: Variant = JSON.parse_string(raw)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("MenuLang: invalid JSON in " + DATA_PATH)
		return false
	_data = parsed
	return true


static func is_loaded() -> bool:
	return _ensure()


static func data() -> Dictionary:
	if not _ensure():
		return {}
	return _data


static func languages() -> Array:
	var out: Array = []
	if not _ensure():
		return out
	for value: Variant in _data.get("languages", []):
		out.append(String(value))
	return out


## Full `LangXxx` name for a full name or short alias; "" when unknown.
static func normalize_language(value: String) -> String:
	var candidate: String = value.strip_edges()
	if candidate.is_empty():
		return ""
	if languages().has(candidate):
		return candidate
	var lowered: String = candidate.to_lower()
	if LANGUAGE_ALIASES.has(lowered):
		return String(LANGUAGE_ALIASES[lowered])
	return ""


static func set_language(value: String) -> String:
	var normalized: String = normalize_language(value)
	_language = normalized if not normalized.is_empty() else FALLBACK_LANGUAGE
	return _language


static func language() -> String:
	if not _language.is_empty():
		return _language
	var from_env: String = normalize_language(OS.get_environment(ENV_LANG))
	_language = from_env if not from_env.is_empty() else FALLBACK_LANGUAGE
	return _language


## Recovered value for `key`, or the key itself when the table has no entry.
static func text(key: String, lang: String = "") -> String:
	if key.is_empty():
		return ""
	if not _ensure():
		return key
	var active: String = normalize_language(lang)
	if active.is_empty():
		active = language()
	var keys: Dictionary = _data.get("keys", {})
	var resolved: String = key
	if not keys.has(resolved):
		# Case-insensitive fallback (the decoded table is lowercase).
		resolved = ""
		var lowered: String = key.to_lower()
		for candidate: Variant in keys.keys():
			if String(candidate).to_lower() == lowered:
				resolved = String(candidate)
				break
		if resolved.is_empty():
			return key
	var row: Variant = keys.get(resolved, {})
	if typeof(row) != TYPE_DICTIONARY:
		return key
	var value: Variant = (row as Dictionary).get(active, null)
	if value == null:
		return key
	return String(value)


static func has_key(key: String) -> bool:
	if not _ensure():
		return false
	return _data.get("keys", {}).has(key)


## Localized character name for a port token (`master` -> `The Master`).
## Falls back to the upper-cased token when no recovered name key exists.
static func character(token: String) -> String:
	if not _ensure():
		return token.to_upper()
	var map: Dictionary = _data.get("character_keys", {})
	var lowered: String = token.strip_edges().to_lower()
	if map.has(lowered):
		return text(String(map[lowered]))
	return token.to_upper()


## Localized label for a prototype-menu command, else the original label.
static func command_label(command: String, fallback: String) -> String:
	if not _ensure():
		return fallback
	var map: Dictionary = _data.get("command_keys", {})
	if map.has(command):
		return text(String(map[command]))
	return fallback


## Localized settings-row label for the recovered schema label (ROUNDS -> ...).
static func setting_label(original: String) -> String:
	if not _ensure():
		return original
	var map: Dictionary = _data.get("setting_keys", {})
	if map.has(original):
		return text(String(map[original]))
	return original


## Localized option label (EASY/MEDIUM/HARD/inf), else the original option.
static func option_label(original: String) -> String:
	if not _ensure():
		return original
	var map: Dictionary = _data.get("option_keys", {})
	if map.has(original):
		return text(String(map[original]))
	return original


## Localized mode label (`arcade` / `survival` / `timeattack`).
static func mode_label(mode: String) -> String:
	if not _ensure():
		return mode.to_upper()
	var map: Dictionary = _data.get("mode_keys", {})
	if map.has(mode):
		return text(String(map[mode]))
	return mode.to_upper()


## System font that can draw the active language's script, or null for the
## engine default (Latin/Cyrillic are covered by the default theme font).
static func ui_font() -> Font:
	var active: String = language()
	if not FONT_NAMES.has(active):
		return null
	if _fonts.has(active):
		return _fonts[active]
	var font: SystemFont = SystemFont.new()
	var names: Array[String] = []
	for font_name: Variant in FONT_NAMES[active]:
		names.append(String(font_name))
	font.font_names = PackedStringArray(names)
	font.allow_system_fallback = true
	_fonts[active] = font
	return font


## Apply the active-language font to a label when one is needed.
static func apply_font(label: Label) -> void:
	var font: Font = ui_font()
	if font != null and label != null:
		label.add_theme_font_override("font_name", font)
