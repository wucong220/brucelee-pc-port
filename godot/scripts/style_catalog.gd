extends RefCounted
class_name StyleCatalog

## Decoded styleeditor.list data for the opt-in Style Editor.
##
## The catalog is generated by tools/build_style_runtime.py from the read-only
## decode at D:/BruceLeeWork/style-editor-20261104. It keeps the original
## 205 strings, all 60 style entries and the recovered .ui widget layouts
## (name / x / y / width / height / options). Nothing here invents a clip: an
## entry carries a direct clip only when the generator found exactly one
## source_action row for that character.

const DATA_PATH: String = "res://data/styleeditor_runtime.json"
const INDEX_PATH: String = "res://data/style_clip_index.json"
const SCHEMA: String = "brucelee-styleeditor-runtime/1"
const GROUP_ORDER: Array[String] = [
    "personality/personality",
    "special/hpunch",
    "special/lpunch",
    "special/hkick",
    "special/lkick",
    "grabs/graba",
    "grabs/grabb",
    "endmove/endmove",
]

var data: Dictionary = {}
var index: Dictionary = {}
var error: String = ""
var loaded: bool = false


func load_catalog(path: String = DATA_PATH, index_path: String = INDEX_PATH) -> bool:
    data = {}
    index = {}
    error = ""
    loaded = false
    if not FileAccess.file_exists(path):
        error = "style catalog missing: " + path
        return false
    var text: String = FileAccess.get_file_as_string(path)
    var json: JSON = JSON.new()
    if json.parse(text) != OK:
        error = "style catalog is not valid JSON: " + json.get_error_message()
        return false
    if typeof(json.data) != TYPE_DICTIONARY:
        error = "style catalog root is not an object"
        return false
    var parsed: Dictionary = json.data
    if String(parsed.get("schema", "")) != SCHEMA:
        error = "unexpected style catalog schema: " + String(parsed.get("schema", ""))
        return false
    if typeof(parsed.get("groups")) != TYPE_DICTIONARY:
        error = "style catalog has no groups"
        return false
    data = parsed
    if FileAccess.file_exists(index_path):
        var index_json: JSON = JSON.new()
        if index_json.parse(FileAccess.get_file_as_string(index_path)) == OK:
            if typeof(index_json.data) == TYPE_DICTIONARY:
                index = index_json.data
    loaded = true
    return true


func group(group_key: String) -> Dictionary:
    var groups: Dictionary = data.get("groups", {})
    return groups.get(group_key, {})


func entries(group_key: String) -> Array:
    return group(group_key).get("entries", [])


func entry(group_key: String, entry_id: String) -> Dictionary:
    for value in entries(group_key):
        if typeof(value) == TYPE_DICTIONARY and String(value.get("id", "")) == entry_id:
            return value
    return {}


func entry_index(group_key: String, entry_id: String) -> int:
    var list: Array = entries(group_key)
    for position in range(list.size()):
        if String(list[position].get("id", "")) == entry_id:
            return position
    return -1


func layout(screen: String) -> Dictionary:
    var layouts: Dictionary = data.get("layouts", {})
    return layouts.get(screen, {})


func widgets(screen: String) -> Array:
    return layout(screen).get("widgets", [])


func widget(screen: String, widget_name: String) -> Dictionary:
    for value in widgets(screen):
        if typeof(value) == TYPE_DICTIONARY and String(value.get("name", "")) == widget_name:
            return value
    return {}


func widget_rect(screen: String, widget_name: String) -> Rect2:
    var value: Dictionary = widget(screen, widget_name)
    if value.is_empty():
        return Rect2()
    return Rect2(
        float(value.get("x", 0)),
        float(value.get("y", 0)),
        float(value.get("width", 0)),
        float(value.get("height", 0)),
    )


func strings_count() -> int:
    return int(data.get("counts", {}).get("strings", 0))


func groups_in_order() -> Array[String]:
    var out: Array[String] = []
    for key in GROUP_ORDER:
        if not group(key).is_empty():
            out.append(key)
    return out


func defaults() -> Dictionary:
    var out: Dictionary = {}
    for key in groups_in_order():
        out[key] = String(group(key).get("default", ""))
    return out


func personality_group_key() -> String:
    return "personality/personality"


func is_personality_injected() -> bool:
    return bool(data.get("personality_injected", false))


## Recovered category menu options from styleeditor.ui, without the injected
## personality row. Used by the screen and by validation so the recovered
## layout can be compared to the actual menu.
func recovered_category_options() -> Array:
    for value in widgets("styleeditor.ui"):
        if String(value.get("type", "")) == "blmenu" and String(value.get("name", "")) == "menu":
            return value.get("options", [])
    return []


## Options shown by the category screen: decoded personality first (the
## recovered menu has no personality row) followed by the recovered options.
func category_options() -> Array:
    var out: Array = []
    if not group(personality_group_key()).is_empty():
        out.append(["personality", "personality"])
    out.append_array(recovered_category_options())
    return out


func special_options() -> Array:
    for value in widgets("stylespecial.ui"):
        if String(value.get("type", "")) == "blmenu":
            return value.get("options", [])
    return []


func grabs_options() -> Array:
    for value in widgets("stylegrabs.ui"):
        if String(value.get("type", "")) == "blmenu":
            return value.get("options", [])
    return []


func group_for_command(command: String) -> String:
    match command:
        "personality":
            return "personality/personality"
        "hpunch", "lpunch", "hkick", "lkick":
            return "special/" + command
        "graba", "grabb":
            return "grabs/" + command
        "endmove":
            return "endmove/endmove"
        _:
            return ""


func status_line() -> String:
    if loaded:
        return "styleeditor.list · %d strings · %d entries" % [
            strings_count(), int(data.get("counts", {}).get("entries", 0))
        ]
    return "style catalog unavailable: " + error
