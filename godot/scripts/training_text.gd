extends RefCounted
class_name PortTrainingText

## Recovered training localization (10 shipped `.lang` languages).
##
## `res://data/lang/training_lang.json` is generated by
## `tools/build_training_data.py` directly from the `Lang*.lang` resources in
## the untouched `data.zpak`; every value is copied verbatim. A key that is not
## in the table is returned unchanged (never invented).

const DATA_PATH := "res://data/lang/training_lang.json"
const ENV_LANG := "BRUCELEE_LANG"
const FALLBACK_LANGUAGE := "LangEnglish"

const FONT_NAMES := {
	"LangChineseSimpl": ["Microsoft YaHei UI", "Microsoft YaHei", "SimSun"],
	"LangChineseTrad": ["Microsoft JhengHei UI", "Microsoft JhengHei", "SimSun"],
	"LangJapanese": ["Yu Gothic UI", "Yu Gothic", "Meiryo", "MS Gothic"],
	"LangKorean": ["Malgun Gothic", "Gulim"],
}

static var _data: Dictionary = {}
static var _loaded: bool = false
static var _language: String = ""
static var _fonts: Dictionary = {}


static func _ensure() -> bool:
	if _loaded:
		return not _data.is_empty()
	_loaded = true
	_data = {}
	if not FileAccess.file_exists(DATA_PATH):
		push_warning("PortTrainingText: missing " + DATA_PATH)
		return false
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("PortTrainingText: invalid " + DATA_PATH)
		return false
	_data = parsed
	return true


static func languages() -> Array:
	_ensure()
	return _data.get("languages", [])


static func set_language(value: String) -> String:
	var normalized := value.strip_edges()
	_ensure()
	if not languages().has(normalized):
		normalized = FALLBACK_LANGUAGE
	_language = normalized
	return _language


static func language() -> String:
	if not _language.is_empty():
		return _language
	var from_env := OS.get_environment(ENV_LANG).strip_edges()
	var names: Array = languages()
	if names.is_empty():
		_language = FALLBACK_LANGUAGE
		return _language
	if names.has(from_env):
		_language = from_env
		return _language
	# Short aliases, mirroring MenuLang so both screens share BRUCELEE_LANG.
	var lowered := from_env.to_lower()
	var aliases := {
		"en": "LangEnglish", "english": "LangEnglish",
		"zh": "LangChineseSimpl", "zhs": "LangChineseSimpl",
		"zh-hans": "LangChineseSimpl", "zh_cn": "LangChineseSimpl",
		"zh-hant": "LangChineseTrad", "zht": "LangChineseTrad",
		"fr": "LangFrench", "de": "LangGerman", "it": "LangItalian",
		"ja": "LangJapanese", "jp": "LangJapanese", "ko": "LangKorean",
		"ru": "LangRussian", "es": "LangSpanish",
	}
	var mapped := String(aliases.get(lowered, ""))
	_language = mapped if names.has(mapped) else FALLBACK_LANGUAGE
	return _language


static func text(key: String, lang: String = "") -> String:
	if key.is_empty():
		return ""
	if not _ensure():
		return key
	var active := lang.strip_edges()
	if active.is_empty():
		active = language()
	var keys: Dictionary = _data.get("keys", {})
	if not keys.has(key):
		return key
	var row: Dictionary = keys[key]
	return String(row.get(active, key))


static func has_key(key: String) -> bool:
	_ensure()
	return _data.get("keys", {}).has(key)


static func ui_font() -> Font:
	var active := language()
	if not FONT_NAMES.has(active):
		return null
	if _fonts.has(active):
		return _fonts[active]
	var font := SystemFont.new()
	var names: Array[String] = []
	for name: Variant in FONT_NAMES[active]:
		names.append(String(name))
	font.font_names = PackedStringArray(names)
	font.allow_system_fallback = true
	_fonts[active] = font
	return font


## Candara is the recovered UI font family (adreno_200/fontsizes.Cfg). Godot
## falls back to the default theme font when Windows lacks it.
static func display_font() -> Font:
	var font := SystemFont.new()
	font.font_names = PackedStringArray([
		"Candara", "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei",
	])
	font.allow_system_fallback = true
	return font


static func apply_font(label: Label, size: int) -> void:
	if label == null:
		return
	var font := ui_font()
	if font == null:
		font = display_font()
	label.add_theme_font_override("font_name", font)
	label.add_theme_font_size_override("font_size", size)
