extends RefCounted
class_name PortRecoveredPages
## Read-only model for the recovered Profile sub-page destinations, the About
## version/disclaimer, and the Settings/Training VIDEO/CONTROLS destination
## records.  Backed by `res://data/menu_art/recovered_pages.json`, generated by
## `tools/build_recovered_pages.py` from local evidence only
## (`adreno_200/game.states`, `adreno_200/gui/*.ui`, `adreno_200/Lang*.lang`).
##
## Contract: every returned string is a verbatim decoded value or the literal
## "NOT RECOVERED".  A missing/invalid artifact fails closed (all accessors
## empty, `available()` false, `error()` names the cause).  No page body, art
## picture, fighter cell, camera value or control mapping is invented.

const DATA_PATH := "res://data/menu_art/recovered_pages.json"
const ENV_PATH := "BRUCELEE_RECOVERED_PAGES_PATH"
const NOT_RECOVERED := "NOT RECOVERED"
const SCHEMA := "brucelee-recovered-pages/1"
const FALLBACK_LANGUAGE := "LangEnglish"
const PROFILE_KEYS := ["achievements", "statistics", "art", "fighters"]

static var _data: Dictionary = {}
static var _error: String = ""
static var _loaded: bool = false
static var _resolved: String = ""


static func path_used() -> String:
	if _resolved.is_empty():
		var env_path: String = OS.get_environment(ENV_PATH)
		_resolved = env_path if not env_path.is_empty() else DATA_PATH
	return _resolved


static func available() -> bool:
	return load_data()


static func error() -> String:
	load_data()
	return _error


static func load_data() -> bool:
	if _loaded:
		return _error.is_empty()
	_loaded = true
	_data = {}
	var path: String = path_used()
	if not FileAccess.file_exists(path):
		_error = "missing artifact: " + path
		return false
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(parsed) != TYPE_DICTIONARY:
		_error = "artifact is not a JSON object: " + path
		return false
	var data: Dictionary = parsed as Dictionary
	if String(data.get("schema", "")) != SCHEMA:
		_error = "unexpected recovered-pages schema"
		return false
	if String(data.get("not_recovered_marker", "")) != NOT_RECOVERED:
		_error = "recovered-pages has no NOT RECOVERED marker"
		return false
	var rows: Array = Array(Dictionary(data.get("profile", {})).get("rows", []))
	if rows.size() != 4:
		_error = "profile rows are not the four decoded playerprofile.ui options"
		return false
	for row: Variant in rows:
		var r: Dictionary = row as Dictionary
		if not PROFILE_KEYS.has(String(r.get("key", ""))):
			_error = "profile row has an unexpected key"
			return false
		if String(Dictionary(r.get("destination", {})).get("state", "")).is_empty():
			_error = "profile row has no recovered destination"
			return false
	var about: Dictionary = data.get("about", {})
	var version_record: Dictionary = Dictionary(about.get("version", {}))
	var version_value: String = String(version_record.get("value", ""))
	var code_version: String = String(version_record.get("code_version", ""))
	if version_value != NOT_RECOVERED and code_version.is_empty():
		_error = "about version is neither NOT RECOVERED nor backed by a recovered code version"
		return false
	if String(Dictionary(Dictionary(about.get("disclaimer", {})).get("labels", {})).get(
			FALLBACK_LANGUAGE, "")).is_empty():
		_error = "about disclaimer has no recovered English text"
		return false
	for area: String in ["settings_video_controls", "training_video_controls"]:
		if String(Dictionary(data.get(area, {})).get("reachability", "")) != NOT_RECOVERED:
			_error = area + " reachability is not marked NOT RECOVERED"
			return false
	_data = data
	return true


static func localized(table: Variant, language: String) -> String:
	if typeof(table) != TYPE_DICTIONARY:
		return ""
	var values: Dictionary = table as Dictionary
	if values.has(language):
		return String(values[language])
	return String(values.get(FALLBACK_LANGUAGE, ""))


static func profile_rows() -> Array:
	if not available():
		return []
	return Array(Dictionary(_data.get("profile", {})).get("rows", [])).duplicate(true)


static func profile_page(key: String) -> Dictionary:
	for row: Variant in profile_rows():
		var r: Dictionary = row as Dictionary
		if String(r.get("key", "")) == key:
			return r
	return {}


static func about() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("about", {})).duplicate(true)


static func about_background_basename() -> String:
	if not available():
		return ""
	return String(Dictionary(_data.get("about", {})).get("background_basename", ""))


static func about_version_text(language: String) -> String:
	if not available():
		return NOT_RECOVERED
	var version: Dictionary = Dictionary(_data.get("about", {})).get("version", {})
	var template: String = localized(version.get("template", {}), language)
	var code_version: String = String(version.get("code_version", ""))
	if template.is_empty() or code_version.is_empty():
		return NOT_RECOVERED
	return template.replace("%s", code_version)


static func about_disclaimer(language: String) -> String:
	if not available():
		return NOT_RECOVERED
	var disclaimer: Dictionary = Dictionary(_data.get("about", {})).get("disclaimer", {})
	var value: String = localized(disclaimer.get("labels", {}), language)
	return value if not value.is_empty() else NOT_RECOVERED


static func settings_video_controls() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("settings_video_controls", {})).duplicate(true)


static func training_video_controls() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("training_video_controls", {})).duplicate(true)


static func credits() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("credits", {})).duplicate(true)


static func credits_scroll() -> Dictionary:
	if not available():
		return {}
	return Dictionary(Dictionary(_data.get("credits", {})).get("scroll", {})).duplicate(true)
