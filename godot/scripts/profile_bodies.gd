extends RefCounted
class_name PortProfileBodies
## Read-only model for the recovered Profile page BODIES.
##
##   * achievements  -> achievementstable.ui (CTX3 DATA reserved-word variant) +
##                      achievements.list (38 rows, pending/reached icons)
##   * statistics    -> stats1.ui / stats2.ui / stats3.ui (reserved = 3/7/7)
##   * art           -> artpicture.ui pictureslider + artpictures.list (18 items).
##                      SLIDER BINDING NOW PROVEN: item order == artpictures.list
##                      array order (native unlocker appends in order); the artwork
##                      pixels stay local-only.
##   * fighters      -> fightergalleryselect.ui grid + characters.list `uniques`
##                      (10 items) + fightergalleryprofile.ui profile page.
##                      GRID BINDING NOW PROVEN: cell i == unique i in array order;
##                      selectedcell == the `fighters_gallery_current` option; the
##                      profile page reads the same option index.
##
## Backed by `res://data/menu_art/profile_bodies.json`, generated by
## `tools/build_profile_bodies.py` from `data.zpak` and the ten `Lang*.lang`
## tables only.  Contract: a returned string is a verbatim decoded value, the
## literal "NOT RECOVERED", or "PROVEN" for a binding backed by native evidence.
## A missing/invalid artifact, a reordered list or a demoted binding fails closed.

const DATA_PATH := "res://data/menu_art/profile_bodies.json"
const ENV_PATH := "BRUCELEE_PROFILE_BODIES_PATH"
const NOT_RECOVERED := "NOT RECOVERED"
const PROVEN := "PROVEN"
const SCHEMA := "brucelee-profile-bodies/1"
const FALLBACK_LANGUAGE := "LangEnglish"
const EXPECTED_ACHIEVEMENTS := 38
const EXPECTED_STATS := {"stats1": 5, "stats2": 7, "stats3": 7}
const EXPECTED_ART := 18
const EXPECTED_FIGHTERS := 10
## Order is part of the proven binding, not a convenience: the native slider
## appends artpictures.list entries in array order (CUnlocker::
## SetArtPicturesToSlider, ELF 0x16f130 -> CPictureSlider::AddPicture 0x219038),
## and CBruceLeeFighterGrid::Redraw (0x247b90) draws characters.list `uniques`
## entries 0..N-1 in array order.  Any other order fails closed.
const EXPECTED_ART_ORDER := [
	"galeryart2_1", "galeryart2-c6", "galeryart1_2", "galeryart1_3",
	"galeryart1_4", "galeryart1_5", "galeryart1_6", "galeryart2-c1",
	"galeryart2-c3", "galeryart2-c4", "galeryart2-c5", "galeryart2_3",
	"galeryart2_5", "galeryart2_6", "galeryart2_7", "galeryart2_8",
	"galeryart2_9", "galeryart2_c2",
]
const EXPECTED_FIGHTER_ORDER := [
	"brucelee", "shenlo", "themaster", "smallboy", "sinfu",
	"chief", "kengodall", "brickdavis", "johnson", "loming",
]
## CBruceLeeFighterGrid numcolumns property default is 2.0 (image 0x2483f0) and
## the decoded fightergalleryselect.ui does not override it.
const EXPECTED_GRID_COLUMNS := 2

static var _data: Dictionary = {}
static var _error: String = ""
static var _loaded: bool = false
static var _resolved: String = ""


static func path_used() -> String:
	if _resolved.is_empty():
		var env_path: String = OS.get_environment(ENV_PATH)
		_resolved = env_path if not env_path.is_empty() else DATA_PATH
	return _resolved


static func available() -> bool:
	return load_data()


static func error() -> String:
	load_data()
	return _error


static func not_recovered() -> String:
	return NOT_RECOVERED


static func load_data() -> bool:
	if _loaded:
		return _error.is_empty()
	_loaded = true
	_data = {}
	var path: String = path_used()
	if not FileAccess.file_exists(path):
		_error = "missing artifact: " + path
		return false
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(parsed) != TYPE_DICTIONARY:
		_error = "artifact is not a JSON object: " + path
		return false
	var data: Dictionary = parsed as Dictionary
	if String(data.get("schema", "")) != SCHEMA:
		_error = "unexpected profile-bodies schema"
		return false
	if String(data.get("not_recovered_marker", "")) != NOT_RECOVERED:
		_error = "profile-bodies has no NOT RECOVERED marker"
		return false
	var achievements: Dictionary = Dictionary(data.get("achievements", {}))
	if String(achievements.get("row_binding", "")) != NOT_RECOVERED:
		_error = "achievements row binding is not marked NOT RECOVERED"
		return false
	var rows: Array = Array(achievements.get("rows", []))
	if rows.size() != EXPECTED_ACHIEVEMENTS:
		_error = "achievements rows are not the 38 decoded achievements.list rows"
		return false
	for row: Variant in rows:
		var r: Dictionary = row as Dictionary
		if String(r.get("description_key", "")).is_empty():
			_error = "achievement row has no description key"
			return false
		if String(Dictionary(r.get("labels", {})).get(FALLBACK_LANGUAGE, "")).is_empty():
			_error = "achievement row has no recovered English text"
			return false
	var pages: Dictionary = Dictionary(Dictionary(data.get("stats", {})).get("pages", {}))
	for page: String in EXPECTED_STATS.keys():
		if not pages.has(page):
			_error = "missing stats page " + page
			return false
		var page_data: Dictionary = Dictionary(pages[page])
		if Array(page_data.get("rows", [])).size() != int(EXPECTED_STATS[page]):
			_error = "stats page " + page + " row count is not the decoded count"
			return false
		if String(page_data.get("values", "")) != NOT_RECOVERED:
			_error = "stats page " + page + " values are not marked NOT RECOVERED"
			return false
	var art: Dictionary = Dictionary(data.get("artpictures", {}))
	if String(art.get("slider_binding", "")) != PROVEN:
		_error = "art slider binding is not marked PROVEN"
		return false
	if String(art.get("slider_binding_evidence", "")).is_empty():
		_error = "art slider binding has no native evidence string"
		return false
	var art_items: Array = Array(art.get("items", []))
	if art_items.size() != EXPECTED_ART:
		_error = "art album items are not the 18 decoded artpictures.list items"
		return false
	for index: int in range(art_items.size()):
		var item: Dictionary = art_items[index] as Dictionary
		if int(item.get("index", -1)) != index:
			_error = "art item index is not its decoded array position"
			return false
		if String(item.get("basename", "")) != String(EXPECTED_ART_ORDER[index]):
			_error = "art item order does not match the proven artpictures.list order"
			return false
		if String(item.get("basename", "")).is_empty():
			_error = "art item has no recovered basename"
			return false
	var fighters: Dictionary = Dictionary(data.get("fighters", {}))
	if String(fighters.get("grid_binding", "")) != PROVEN:
		_error = "fighter grid binding is not marked PROVEN"
		return false
	if String(fighters.get("grid_binding_evidence", "")).is_empty():
		_error = "fighter grid binding has no native evidence string"
		return false
	if String(fighters.get("selection", "")) != PROVEN:
		_error = "fighter selectedcell binding is not marked PROVEN"
		return false
	if String(fighters.get("profile_binding", "")) != PROVEN:
		_error = "fighter profile binding is not marked PROVEN"
		return false
	var columns: int = int(fighters.get("grid_numcolumns", 0))
	if columns != EXPECTED_GRID_COLUMNS:
		_error = "fighter grid numcolumns is not the proven default 2"
		return false
	var fighter_items: Array = Array(fighters.get("items", []))
	if fighter_items.size() != EXPECTED_FIGHTERS:
		_error = "fighter items are not the 10 decoded characters.list uniques"
		return false
	for index: int in range(fighter_items.size()):
		var f: Dictionary = fighter_items[index] as Dictionary
		if int(f.get("index", -1)) != index:
			_error = "fighter item index is not its decoded array position"
			return false
		if String(f.get("name", "")) != String(EXPECTED_FIGHTER_ORDER[index]):
			_error = "fighter order does not match the proven characters.list order"
			return false
		if String(f.get("name", "")).is_empty():
			_error = "fighter item has no recovered name"
			return false
		if String(Dictionary(f.get("name_labels", {})).get(FALLBACK_LANGUAGE, "")).is_empty():
			_error = "fighter item has no recovered display name"
			return false
	_data = data
	return true


static func localized(table: Variant, language: String) -> String:
	if typeof(table) != TYPE_DICTIONARY:
		return ""
	var values: Dictionary = table as Dictionary
	if values.has(language):
		return String(values[language])
	return String(values.get(FALLBACK_LANGUAGE, ""))


static func achievements() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("achievements", {})).duplicate(true)


static func achievement_rows() -> Array:
	return Array(achievements().get("rows", []))


static func stats_pages() -> Dictionary:
	if not available():
		return {}
	return Dictionary(Dictionary(_data.get("stats", {})).get("pages", {})).duplicate(true)


## `name` is "stats1", "stats2" or "stats3".
static func stats_page(name: String) -> Dictionary:
	return Dictionary(stats_pages().get(name, {}))


static func stats_submenu() -> Dictionary:
	if not available():
		return {}
	return Dictionary(Dictionary(_data.get("stats", {})).get("submenu", {})).duplicate(true)


static func artpictures() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("artpictures", {})).duplicate(true)


static func art_items() -> Array:
	return Array(artpictures().get("items", []))


static func fighters() -> Dictionary:
	if not available():
		return {}
	return Dictionary(_data.get("fighters", {})).duplicate(true)


static func fighter_items() -> Array:
	return Array(fighters().get("items", []))


static func art_item(index: int) -> Dictionary:
	var items: Array = art_items()
	if index < 0 or index >= items.size():
		return {}
	return Dictionary(items[index])


static func fighter_item(index: int) -> Dictionary:
	var items: Array = fighter_items()
	if index < 0 or index >= items.size():
		return {}
	return Dictionary(items[index])


## Row-major column count proven from the control property default, never a guess.
static func grid_columns() -> int:
	return int(fighters().get("grid_numcolumns", 0))


static func grid_columnseparation() -> float:
	return float(fighters().get("grid_columnseparation", 0.0))


static func grid_rowheight() -> float:
	return float(fighters().get("grid_rowheight", 0.0))


static func selectedcell_option() -> String:
	return String(fighters().get("selectedcell_option", ""))


static func expected_art_order() -> Array:
	return EXPECTED_ART_ORDER.duplicate()


static func expected_fighter_order() -> Array:
	return EXPECTED_FIGHTER_ORDER.duplicate()
