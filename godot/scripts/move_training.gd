# --------------------------------------------------------------- navigation

func selectable_trainings() -> Array:
    ## Only entries with a recovered menu binding are exposed.  The eighth
    ## training.list entry has no selecttraining.ui row and is not invented.
    var out: Array = []
    for training: Variant in trainings:
        if (training as Dictionary).get("menu_option", null) != null:
            out.append(training)
    return out


func unbound_trainings() -> Array:
    var out: Array = []
    for training: Variant in trainings:
        if (training as Dictionary).get("menu_option", null) == null:
            out.append(training)
    return out


func practice_options() -> Array:
    var out: Array = []
    var screens: Dictionary = _ui.get("screens", {})
    if screens.has("practice_menu"):
        for widget: Variant in Array(screens["practice_menu"].get("layout", [])):
            var node: Dictionary = widget
            if String(node.get("type", "")) != "blmenu":
                continue
            for option: Variant in Array(node.get("options", [])):
                var pair: Array = option
                out.append({"label_key": String(pair[0]), "action": String(pair[1])})
    return out


func free_config_options() -> Array:
    var out: Array = []
    var screens: Dictionary = _ui.get("screens", {})
    if screens.has("free_config"):
        for widget: Variant in Array(screens["free_config"].get("layout", [])):
            var node: Dictionary = widget
            if String(node.get("type", "")) != "blmenu":
                continue
            for option: Variant in Array(node.get("options", [])):
                var pair: Array = option
                out.append({"label_key": String(pair[0]), "action": String(pair[1])})
    return out


func pause_options() -> Array:
    ## trainingpause.ui has six recovered options.  The shipped
    ## trainingpausenoeditor.ui is the five-option variant used when the editor
    ## is compiled out; this build supports the editor, so all six are restored.
    var out: Array = []
    var screens: Dictionary = _ui.get("screens", {})
    if screens.has("pause"):
        for widget: Variant in Array(screens["pause"].get("layout", [])):
            var node: Dictionary = widget
            if String(node.get("type", "")) != "blmenu":
                continue
            for option: Variant in Array(node.get("options", [])):
                var pair: Array = option
                out.append({"label_key": String(pair[0]), "action": String(pair[1])})
    return out


func fighter_dock_entries() -> Array:
    ## Recovered dock icons in archive order, joined to the runtime candidate
    ## keys.  An unknown icon or a count mismatch fails closed instead of
    ## guessing a fighter.
    var out: Array = []
    var screens: Dictionary = _ui.get("screens", {})
    if not screens.has("select_fighter"):
        return out
    var dock: Dictionary = {}
    for widget: Variant in Array(screens["select_fighter"].get("layout", [])):
        if String((widget as Dictionary).get("type", "")) == "bldock":
            dock = widget
            break
    if dock.is_empty():
        return out
    var items: Array = Array(dock.get("items", []))
    if items.size() != FIGHTER_DOCK.size():
        push_error("trainingselectfighter.ui item count changed")
        return out
    for i: int in range(items.size()):
        var item: Dictionary = items[i]
        var ref: Variant = item.get("$file", null)
        if not ref is Dictionary:
            push_error("trainingselectfighter.ui item has no file reference")
            return []
        var basename := String(Dictionary(ref).get("basename", ""))
        var matched: Dictionary = {}
        for candidate: Variant in FIGHTER_DOCK:
            if String((candidate as Dictionary)["icon"]) == basename:
                matched = candidate
                break
        if matched.is_empty():
            push_error("trainingselectfighter.ui icon not recovered: " + basename)
            return []
        var entry := matched.duplicate()
        entry["basename"] = basename
        entry["name"] = TrainingText.text(String(entry["name_key"]))
        entry["selectable"] = fighter_entry_selectable(entry)
        out.append(entry)
    return out


func fighter_entry_selectable(entry: Dictionary) -> bool:
    var key := String(entry.get("opponent", ""))
    if key.is_empty():
        return false
    if main != null and main.has_method("training_opponent_keys"):
        return Array(main.training_opponent_keys()).has(key)
    return true


func current_opponent_key() -> String:
    if main != null and main.has_method("training_current_opponent_key"):
        return String(main.training_current_opponent_key())
    return "brick"


func _as_text(value: Variant) -> String:
    if value == null:
        return ""
    return String(value)


func training_label(training: Dictionary) -> String:
    if training.has("title_text"):
        return String(training["title_text"])
    return TrainingText.text(String(training.get("title_key", "")))


func step_title(step: Dictionary) -> String:
    if step.has("input_title_text"):
        return String(step["input_title_text"])
    var key := _as_text(step.get("input_title_key", null))
    if key.is_empty():
        return ""
    return TrainingText.text(key)


func explanation_text(training: Dictionary) -> String:
    if training.has("explanation_text"):
        return String(training["explanation_text"])
    return TrainingText.text(String(training.get("explanation_key", "")))


func is_active() -> bool:
    return state in [
        "practice", "select", "free_config", "select_fighter", "intro",
        "active", "pause", "complete", "command_list", "free"]


func is_lesson_active() -> bool:
    return state == "active"


func freezes_world() -> bool:
    return state in [
        "practice", "select", "free_config", "select_fighter", "intro",
        "complete", "pause", "command_list"]


func open() -> void:
    if trainings.is_empty():
        push_error("Training data did not load: " + data_error)
        return
    state = "practice"
    selected_index = 0
    current_training = {}
    steps = []
    current_step = {}
    success_timer = -1.0
    _practice_index = 0
    visible = true
    _load_background()
    _show_screen("practice")
    _refresh_practice()


func open_select() -> void:
    ## Direct select entry used by tests and by callers that already passed the
    ## practice menu.
    if trainings.is_empty():
        return
    state = "select"
    selected_index = 0
    current_training = {}
    steps = []
    current_step = {}
    success_timer = -1.0
    visible = true
    _load_background()
    _show_screen("select")
    _refresh_select()


func close() -> void:
    state = "hidden"
    visible = false
    _notice.visible = false
    if get_tree() != null:
        get_tree().paused = false
    if player != null:
        player.attack_root_motion_enabled = true
        player.set_physics_process(true)
    if computer != null:
        computer.set_physics_process(true)
        computer.collision_layer = 2
        computer.collision_mask = 1 | 2


func _load_background() -> void:
    var path := practice_background_path()
    if not path.is_empty() and FileAccess.file_exists(path):
        var image := Image.new()
        if image.load(path) == OK:
            _background.texture = ImageTexture.create_from_image(image)
            return
    _background.texture = null


func _layout_frame() -> void:
    var viewport := get_viewport().get_visible_rect().size
    if viewport.x <= 0.0 or viewport.y <= 0.0:
        return
    var scale_factor: float = minf(
        viewport.x / REFERENCE_WIDTH, viewport.y / REFERENCE_HEIGHT)
    _frame.scale = Vector2(scale_factor, scale_factor)
    _frame.position = Vector2(
        (viewport.x - REFERENCE_WIDTH * scale_factor) * 0.5,
        (viewport.y - REFERENCE_HEIGHT * scale_factor) * 0.5)


func _show_screen(name: String) -> void:
    for key: String in _screens:
        _screens[key].visible = (key == name)
    # Menu/config screens use the recovered practice background; the lesson,
    # pause, command list and completion screens show the live training ground.
    _background.visible = name in [
        "practice", "select", "free_config", "select_fighter", "intro"]
    _dim.visible = name in ["pause", "complete", "command_list"]


func show_notice(message: String, is_error: bool = false) -> void:
    if _notice == null:
        return
    _notice.text = message
    _notice.visible = not message.is_empty()
    _notice.add_theme_color_override("font_color",
        Color(1.0, 0.45, 0.35) if is_error else Color(1.0, 0.86, 0.30))


# ------------------------------------------------------------------ practice

func _refresh_practice() -> void:
    _practice_title.text = TrainingText.text("practice_style")
    var options := practice_options()
    for i: int in range(_practice_items.size()):
        if i >= options.size():
            _practice_items[i].visible = false
            continue
        _practice_items[i].visible = true
        _practice_items[i].text = TrainingText.text(String(options[i]["label_key"]))
        _practice_items[i].add_theme_color_override("font_color",
            _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
                Color(1.0, 1.0, 0.0)) if i == _practice_index
            else _color8(_ui.get("colors", {}).get("text", [255, 255, 255]),
                Color.WHITE))


func _move_practice(step: int) -> void:
    var count := practice_options().size()
    if count <= 0:
        return
    _practice_index = wrapi(_practice_index + step, 0, count)
    _refresh_practice()


func _accept_practice() -> void:
    var options := practice_options()
    if _practice_index < 0 or _practice_index >= options.size():
        return
    match String(options[_practice_index]["action"]):
        "training":
            open_select()
        "editor":
            style_editor_requested.emit()
        _:
            show_notice("PRACTICE OPTION NOT RECOVERED", true)


# -------------------------------------------------------------------- select

func _refresh_select() -> void:
    var selectable := selectable_trainings()
    _title_label.text = TrainingText.text("training")
    for i: int in range(_select_items.size()):
        if i >= selectable.size():
            _select_items[i].visible = false
            continue
        _select_items[i].visible = true
        _select_items[i].text = training_label(selectable[i])
        _select_items[i].add_theme_color_override("font_color",
            _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
                Color(1.0, 1.0, 0.0)) if i == selected_index
            else _color8(_ui.get("colors", {}).get("text", [255, 255, 255]),
                Color.WHITE))


func _move_selection(step: int) -> void:
    var count := selectable_trainings().size()
    if count <= 0:
        return
    selected_index = wrapi(selected_index + step, 0, count)
    _refresh_select()


func _accept_selected() -> void:
    var selectable := selectable_trainings()
    if selected_index < 0 or selected_index >= selectable.size():
        return
    current_training = selectable[selected_index]
    steps = current_training.get("steps", [])
    if _is_free_training(current_training):
        _enter_free_config()
        return
    _enter_intro()


func _is_free_training(training: Dictionary) -> bool:
    if _as_text(training.get("menu_option", null)) == "free_training":
        return true
    for step: Variant in Array(training.get("steps", [])):
        if not Array((step as Dictionary).get("success_animations", [])).is_empty():
            return false
    return true


