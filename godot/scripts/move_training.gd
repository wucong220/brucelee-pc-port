# --------------------------------------------------------------- navigation

func selectable_trainings() -> Array:
    var out: Array = []
    for training: Variant in trainings:
        if (training as Dictionary).get("menu_option", null) != null:
            out.append(training)
    return out


func _as_text(value: Variant) -> String:
    if value == null:
        return ""
    return String(value)


func training_label(training: Dictionary) -> String:
    if training.has("title_text"):
        return String(training["title_text"])
    return TrainingText.text(String(training.get("title_key", "")))


func step_title(step: Dictionary) -> String:
    if step.has("input_title_text"):
        return String(step["input_title_text"])
    var key := _as_text(step.get("input_title_key", null))
    if key.is_empty():
        return ""
    return TrainingText.text(key)


func explanation_text(training: Dictionary) -> String:
    if training.has("explanation_text"):
        return String(training["explanation_text"])
    return TrainingText.text(String(training.get("explanation_key", "")))


func is_active() -> bool:
    return state in ["select", "intro", "active", "pause", "complete", "free"]


func is_lesson_active() -> bool:
    return state == "active"


## Main freezes its own AI/movement while a menu-like training screen is up.
func freezes_world() -> bool:
    return state in ["select", "intro", "complete", "pause"]


func open() -> void:
    if trainings.is_empty():
        push_error("Training data did not load: " + data_error)
        return
    state = "select"
    selected_index = 0
    current_training = {}
    steps = []
    current_step = {}
    success_timer = -1.0
    visible = true
    _load_background()
    _show_screen("select")
    _refresh_select()


func close() -> void:
    state = "hidden"
    visible = false
    if get_tree() != null:
        get_tree().paused = false
    if player != null:
        player.attack_root_motion_enabled = true
        player.set_physics_process(true)
    if computer != null:
        computer.set_physics_process(true)
        computer.collision_layer = 2
        computer.collision_mask = 1 | 2


func _load_background() -> void:
    var path := practice_background_path()
    if not path.is_empty() and FileAccess.file_exists(path):
        var image := Image.new()
        if image.load(path) == OK:
            _background.texture = ImageTexture.create_from_image(image)
            return
    _background.texture = null


func _layout_frame() -> void:
    var viewport := get_viewport().get_visible_rect().size
    if viewport.x <= 0.0 or viewport.y <= 0.0:
        return
    var scale_factor: float = minf(
        viewport.x / REFERENCE_WIDTH, viewport.y / REFERENCE_HEIGHT)
    _frame.scale = Vector2(scale_factor, scale_factor)
    _frame.position = Vector2(
        (viewport.x - REFERENCE_WIDTH * scale_factor) * 0.5,
        (viewport.y - REFERENCE_HEIGHT * scale_factor) * 0.5)


func _show_screen(name: String) -> void:
    for key: String in _screens:
        _screens[key].visible = (key == name)
    # Menu/introduction screens use the recovered practice background; the
    # lesson, pause and completion screens show the live 3D training ground.
    _background.visible = name in ["select", "intro"]
    _dim.visible = name in ["pause", "complete"]


func _refresh_select() -> void:
    var selectable := selectable_trainings()
    _title_label.text = TrainingText.text("training")
    for i: int in range(_select_items.size()):
        if i >= selectable.size():
            _select_items[i].visible = false
            continue
        _select_items[i].visible = true
        _select_items[i].text = training_label(selectable[i])
        _select_items[i].add_theme_color_override("font_color",
            _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
                Color(1.0, 1.0, 0.0)) if i == selected_index
            else _color8(_ui.get("colors", {}).get("text", [255, 255, 255]),
                Color.WHITE))


func _move_selection(step: int) -> void:
    var count := selectable_trainings().size()
    if count <= 0:
        return
    selected_index = wrapi(selected_index + step, 0, count)
    _refresh_select()


func _accept_selected() -> void:
    var selectable := selectable_trainings()
    if selected_index < 0 or selected_index >= selectable.size():
        return
    current_training = selectable[selected_index]
    steps = current_training.get("steps", [])
    if _is_free_training(current_training):
        _enter_free()
        return
    _enter_intro()


func _is_free_training(training: Dictionary) -> bool:
    if _as_text(training.get("menu_option", null)) == "free_training":
        return true
    for step: Variant in Array(training.get("steps", [])):
        if not Array((step as Dictionary).get("success_animations", [])).is_empty():
            return false
    return true


func _enter_intro() -> void:
    _intro_pages = _paginate(explanation_text(current_training))
    _intro_page = 0
    state = "intro"
    _show_screen("intro")
    _refresh_intro()


## The recovered textbox declares morepagesiconenabled/morepagesicon; keep
## three recovered lines per page so long help text never overflows the panel.
const INTRO_LINES_PER_PAGE := 3


func _paginate(text: String) -> Array:
    var lines: PackedStringArray = text.split("\n")
    var pages: Array = []
    var page: Array[String] = []
    for line: String in lines:
        page.append(line)
        if page.size() >= INTRO_LINES_PER_PAGE:
            pages.append("\n".join(page))
            page = []
    if not page.is_empty() or pages.is_empty():
        pages.append("\n".join(page))
    return pages


func intro_full_text() -> String:
    return "\n".join(_intro_pages)


func _refresh_intro() -> void:
    if _intro_pages.is_empty():
        _intro_pages = [""]
    _intro_page = clampi(_intro_page, 0, _intro_pages.size() - 1)
    _intro_label.text = String(_intro_pages[_intro_page])
    _intro_page_icon.visible = _intro_pages.size() > 1


func _intro_advance() -> void:
    if _intro_page + 1 < _intro_pages.size():
        _intro_page += 1
        _refresh_intro()
        return
    _begin_lesson_session()


func _begin_lesson_session() -> void:
    if main == null or not main.has_method("begin_training_session"):
        push_error("Training needs main.begin_training_session()")
        return
    main.begin_training_session()
    state = "active"
    current_step_index = 0
    _show_screen("active")
    _start_step(0)


func _enter_free() -> void:
    if main == null or not main.has_method("begin_training_session"):
        return
    main.begin_training_session()
    state = "free"
    _show_screen("free")
    _free_title.text = training_label(current_training)
    _setup_dummy_stand()


func _start_step(index: int) -> void:
    if steps.is_empty():
        _complete()
        return
    current_step_index = clampi(index, 0, steps.size() - 1)
    current_step = steps[current_step_index]
    success_timer = -1.0
    _dummy_timer = 0.8
    _dummy_cycle = 0
    _prepare_step()
    _refresh_lesson()


func _prepare_step() -> void:
    if player == null or computer == null:
        return
    player.set_physics_process(true)
    player.attack_root_motion_enabled = true
    player.reset_fighter(Vector3(-0.25, 1.20, 0.0))
    player.health = 9999.0
    player.rage = PortFighter.RAGE_MAX if bool(current_step.get("infinite_rage", false)) else 0.0
    computer.set_physics_process(true)
    computer.reset_fighter(Vector3(0.25, 1.20, 0.0))
    computer.health = 9999.0
    computer.guard_held = false
    # Overlapping capsules would push the player off the floor; keep the visual
    # dummy but do not collide with it (same isolation as the old training).
    computer.collision_layer = 0
    computer.collision_mask = 1
    if _dummy_mode() == "stun":
        computer.state = "stun"
        computer.state_time = 999.0
        computer._animate_candidate()


func _setup_dummy_stand() -> void:
    if player == null or computer == null:
        return
    player.set_physics_process(true)
    player.reset_fighter(Vector3(-0.25, 1.20, 0.0))
    player.health = 9999.0
    player.rage = PortFighter.RAGE_MAX
    computer.set_physics_process(true)
    computer.reset_fighter(Vector3(0.25, 1.20, 0.0))
    computer.health = 9999.0
    computer.collision_layer = 0
    computer.collision_mask = 1
    computer.state = "idle"
    computer._animate_candidate()


func _dummy_mode() -> String:
    if _as_text(current_step.get("dummy_start_anim", null)) == "stun":
        return "stun"
    var ai := _as_text(current_step.get("dummy_ai", null))
    if ai.ends_with("training_stun.tree"):
        return "stun"
    if ai.ends_with("training_attack.tree"):
        return "attack"
    return "stand"


func _refresh_lesson() -> void:
    _hud_title.text = training_label(current_training)
    _hud_progress.text = "%02d / %02d" % [
        current_step_index + 1, steps.size()]
    _move_label.text = step_title(current_step).to_upper()
    _input_label.text = _format_input(current_step)
    _status_label.text = ""
    _status_label.add_theme_color_override("font_color", Color(0.62, 0.86, 0.62))


func _format_input(step: Dictionary) -> String:
    var sequences: Array = step.get("input_sequences", [])
    var lines: Array[String] = []
    for sequence: Variant in sequences:
        var parts: Array[String] = []
        for token: Variant in Array(sequence):
            parts.append(_token_label(String(token)))
        lines.append(" ".join(parts))
    return "\n".join(lines)


func _token_label(token: String) -> String:
    match token:
        "hold":
            return "HOLD"
        "+":
            return "+"
        ",":
            return "THEN"
        "hpunch":
            return "HPUNCH [J]"
        "lpunch":
            return "LPUNCH [K]"
        "hkick":
            return "HKICK [L]"
        "lkick":
            return "LKICK [U]"
        "right":
            return "RIGHT [D]"
        "left":
            return "LEFT [A]"
        "up":
            return "UP [W]"
        "down":
            return "DOWN [S]"
    return token.to_upper()


func _set_hud_visible(value: bool) -> void:
    if main == null:
        return
    var hud = main.get("hud")
    if hud != null:
        hud.visible = value


func _complete() -> void:
    state = "complete"
    success_timer = -1.0
    _show_screen("complete")
    _set_hud_visible(false)
    _complete_title.text = training_label(current_training)
    if player != null:
        player.set_physics_process(false)
    if computer != null:
        computer.set_physics_process(false)


func _advance_step() -> void:
    success_timer = -1.0
    if current_step_index + 1 >= steps.size():
        _complete()
        return
    _start_step(current_step_index + 1)


func _success() -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var duration := float(current_step.get("success_duration", 2.1))
    success_timer = maxf(duration, 0.35)
    _status_label.text = "OK"
    _status_label.add_theme_color_override("font_color", Color(0.55, 1.0, 0.55))


# ------------------------------------------------------------------- pause

func _open_pause() -> void:
    _pause_previous = state if state != "pause" else _pause_previous
    state = "pause"
    _pause_index = 0
    _show_screen("pause")
    _set_hud_visible(false)
    _refresh_pause()
    if get_tree() != null:
        get_tree().paused = true


func _refresh_pause() -> void:
    var labels := [
        TrainingText.text("resume"),
        TrainingText.text("select_training"),
        TrainingText.text("main_menu"),
    ]
    for i: int in range(_pause_items.size()):
        _pause_items[i].text = String(labels[i])
        _pause_items[i].add_theme_color_override("font_color",
            _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
                Color(1.0, 1.0, 0.0)) if i == _pause_index
            else _color8(_ui.get("colors", {}).get("text", [255, 255, 255]),
                Color.WHITE))


func _pause_accept() -> void:
    match _pause_index:
        0:
            if get_tree() != null:
                get_tree().paused = false
            state = _pause_previous
            _show_screen(state)
            _set_hud_visible(state == "active" or state == "free")
        1:
            if get_tree() != null:
                get_tree().paused = false
            if main != null and main.has_method("end_training_session"):
                main.end_training_session()
            state = "select"
            _show_screen("select")
            _refresh_select()
        2:
            if get_tree() != null:
                get_tree().paused = false
            close()
            exit_requested.emit()


# ------------------------------------------------------------------- input

func _key_pressed(event: InputEvent, keys: Array) -> bool:
    var key_event: InputEventKey = event as InputEventKey
    if key_event == null or not key_event.pressed or key_event.echo:
        return false
    return key_event.keycode in keys


func _is_up(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MENU_UP)
            or event.is_action_pressed(Controls.MOVE_UP)
            or _key_pressed(event, [KEY_UP, KEY_W]))


func _is_down(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MENU_DOWN)
            or event.is_action_pressed(Controls.MOVE_DOWN)
            or _key_pressed(event, [KEY_DOWN, KEY_S]))


## Input arrives here directly (PROCESS_MODE_ALWAYS) so the training screens
## keep working while the tree is paused; main.gd no longer routes these keys.
func _input(event: InputEvent) -> void:
    if not visible:
        return
    if handle_input_event(event):
        get_viewport().set_input_as_handled()


func handle_input_event(event: InputEvent) -> bool:
    if not visible or not Controls.is_press_edge(event):
        return false
    match state:
        "select":
            return _handle_select_input(event)
        "intro":
            return _handle_intro_input(event)
        "active":
            return _handle_active_input(event)
        "pause":
            return _handle_pause_input(event)
        "complete":
            return _handle_complete_input(event)
        "free":
            if event.is_action_pressed(Controls.PAUSE) \
                    or event.is_action_pressed(Controls.MENU_CANCEL):
                _open_pause()
                return true
    return false


func _handle_select_input(event: InputEvent) -> bool:
    if _is_up(event):
        _move_selection(-1)
        return true
    if _is_down(event):
        _move_selection(1)
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _accept_selected()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        close()
        exit_requested.emit()
        return true
    return false


func _handle_intro_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _intro_advance()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        state = "select"
        _show_screen("select")
        _refresh_select()
        return true
    return false


func _handle_active_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.PAUSE):
        _open_pause()
        return true
    if event.is_action_pressed(Controls.RESTART):
        _start_step(current_step_index)
        return true
    # Fast advance / retreat: two presses of the same direction inside 320 ms.
    if event.is_action_pressed(Controls.MOVE_RIGHT):
        _note_tap("right")
        return false
    if event.is_action_pressed(Controls.MOVE_LEFT):
        _note_tap("left")
        return false
    return false


func _note_tap(direction: String) -> void:
    if player == null:
        return
    var now := Time.get_ticks_msec()
    var last := int(_last_tap.get(direction, -1))
    _last_tap[direction] = now
    if last >= 0 and now - last <= 320:
        if direction == "right":
            player.request_skip("skipfwd")
        else:
            player.request_skip("skipback")
        _last_tap[direction] = -1


func _handle_pause_input(event: InputEvent) -> bool:
    if _is_up(event):
        _pause_index = wrapi(_pause_index - 1, 0, _pause_items.size())
        _refresh_pause()
        return true
    if _is_down(event):
        _pause_index = wrapi(_pause_index + 1, 0, _pause_items.size())
        _refresh_pause()
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _pause_accept()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        if get_tree() != null:
            get_tree().paused = false
        state = _pause_previous
        _show_screen(state)
        _set_hud_visible(state == "active" or state == "free")
        return true
    return false


func _handle_complete_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        if main != null and main.has_method("end_training_session"):
            main.end_training_session()
        state = "select"
        _show_screen("select")
        _refresh_select()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        close()
        exit_requested.emit()
        return true
    return false


# --------------------------------------------------------------- per frame

func _process(delta: float) -> void:
    if visible:
        _layout_frame()
    if state != "active" or player == null or computer == null:
        return
    _keep_fighters_alive()
    _drive_dummy(delta)
    if success_timer >= 0.0:
        success_timer -= delta
        if success_timer <= 0.0:
            _advance_step()
        return
    var action := _player_native_action()
    if not action.is_empty() \
            and action in Array(current_step.get("success_animations", [])):
        _success()


func _keep_fighters_alive() -> void:
    player.health = 9999.0
    if bool(current_step.get("infinite_rage", false)):
        player.rage = PortFighter.RAGE_MAX
    var dummy_health: Variant = current_step.get("dummy_health", null)
    if dummy_health == null:
        computer.health = 9999.0
    else:
        computer.health = float(dummy_health)
    if _dummy_mode() != "stun" and computer.state in [
            "ko", "facedownko", "faceupko", "facedownidle", "faceupidle"]:
        computer.state = "idle"
        computer.attack_kind = ""
        computer._animate_candidate()


func _drive_dummy(delta: float) -> void:
    var mode := _dummy_mode()
    if mode == "stun":
        if computer.state not in [
                "stun", "stun2", "stunfall", "impactstun", "stunimpact",
                "hitstun", "grabbed1", "grabbed2"]:
            computer.state = "stun"
            computer.state_time = 999.0
            computer.attack_kind = ""
            computer._animate_candidate()
        return
    if mode == "attack":
        if computer.state in ["idle2", "idle3"]:
            computer.state = "idle"
        if computer.state == "idle":
            _dummy_timer -= delta
            if _dummy_timer <= 0.0:
                var kind := "high_punch"
                if not _is_counter_step() and _dummy_cycle % 2 == 1:
                    kind = "low_kick"
                _dummy_cycle += 1
                if computer.request_attack(kind):
                    _dummy_timer = 1.6
        return
    if computer.state in ["idle2", "idle3"]:
        computer.state = "idle"


func _is_counter_step() -> bool:
    return "parryattack" in Array(current_step.get("success_animations", []))


func _player_native_action() -> String:
    if player.attack_kind != "" and player.state in ["startup", "active", "recovery"]:
        var row: Dictionary = player.ATTACKS.get(player.attack_kind, {})
        var source := String(row.get("source_action", ""))
        if not source.is_empty():
            return source
        return player.attack_kind
    var current := String(player._current_action_name())
    if current in MOVEMENT_ACTIONS:
        return current
    var locomotion := String(player._locomotion_action)
    if locomotion in MOVEMENT_ACTIONS:
        return locomotion
    if player._skip_time > 0.0:
        return String(player._skip_action)
    return ""


# --------------------------------------------------------------- signals

func _on_attack_started(action: String) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var source := action
    var row: Dictionary = player.ATTACKS.get(action, {})
    if row.has("source_action"):
        source = String(row["source_action"])
    if source in Array(current_step.get("success_animations", [])):
        _success()


func _on_combat_hit(attacker: PortFighter, defender: PortFighter, action: String,
        _damage: float, blocked: bool) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    if defender != player or not blocked:
        return
    var animations: Array = current_step.get("success_animations", [])
    for block_action: String in BLOCK_ACTIONS:
        if block_action in animations:
            _success()
            return


func _on_parry_succeeded(action: String) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var source := action
    var row: Dictionary = player.ATTACKS.get(action, {})
    if row.has("source_action"):
        source = String(row["source_action"])
    var animations: Array = current_step.get("success_animations", [])
    if source in animations or action in animations:
        _success()

