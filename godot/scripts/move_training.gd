extends CanvasLayer
class_name PortMoveTraining

## Recovered native training screen (training.list).
##
## The lesson list, required move, success condition, prompts and completion
## come from `res://data/training_native.json`, generated by
## `tools/build_training_data.py` directly from `adreno_200/training.list` in
## the untouched data.zpak. The screen geometry is the decoded
## `selecttraining.ui`, `trainingintroduction.ui` and `trainingpause.ui`
## layout (see `res://data/training_ui.json`); no lesson text is invented here.
##
## Legacy fallback: the previous 25-entry hand-written catalog is only loaded
## when the recovered data file is missing (kept for isolated builds that do
## not ship the extracted resources).

signal exit_requested

const DATA_PATH := "res://data/training_native.json"
const UI_PATH := "res://data/training_ui.json"
const LEGACY_CATALOG_PATH := "res://data/move_training_catalog.json"
const Controls := preload("res://scripts/prototype_controls.gd")
const TrainingText := preload("res://scripts/training_text.gd")

const REFERENCE_WIDTH := 480.0
const REFERENCE_HEIGHT := 320.0

## Recovered native action names that describe movement success.
const MOVEMENT_ACTIONS := [
    "stepfwd", "stepback", "stepleft", "stepright",
    "movefwd", "moveback", "moveleft", "moveright",
    "skipfwd", "skipback",
]
const BLOCK_ACTIONS := ["highblock", "lowblock", "midblock"]

var main: Node
var player: PortFighter
var computer: PortFighter

var trainings: Array = []
var using_fallback := false
var data_error := ""

var state := "hidden"
var selected_index := 0
var current_training: Dictionary = {}
var steps: Array = []
var current_step_index := 0
var current_step: Dictionary = {}

var success_timer := -1.0
var _dummy_timer := 0.0
var _dummy_cycle := 0
var _intro_page := 0
var _intro_pages: Array = []
var _pause_index := 0
var _pause_previous := "active"
var _last_tap: Dictionary = {}
var _ui: Dictionary = {}

var _frame: Control
var _background: TextureRect
var _dim: ColorRect
var _screens: Dictionary = {}
var _title_label: Label
var _select_items: Array[Label] = []
var _intro_panel: Panel
var _intro_label: Label
var _intro_page_icon: TextureRect
var _hud_title: Label
var _hud_progress: Label
var _move_label: Label
var _input_label: Label
var _status_label: Label
var _pause_items: Array[Label] = []
var _complete_panel: Panel
var _complete_title: Label
var _free_title: Label


func configure(main_node: Node, player_node: PortFighter, computer_node: PortFighter) -> void:
    main = main_node
    player = player_node
    computer = computer_node
    _load_data()
    _load_ui()
    _build_ui()
    if player != null:
        player.combat_hit.connect(_on_combat_hit)
        player.parry_succeeded.connect(_on_parry_succeeded)
        player.attack_started.connect(_on_attack_started)


# --------------------------------------------------------------- data load

func _load_data() -> void:
    trainings = []
    using_fallback = false
    data_error = ""
    if FileAccess.file_exists(DATA_PATH):
        var parsed: Variant = JSON.parse_string(
            FileAccess.get_file_as_string(DATA_PATH))
        if typeof(parsed) == TYPE_DICTIONARY \
                and parsed.get("trainings", null) is Array \
                and not Array(parsed["trainings"]).is_empty():
            trainings = parsed["trainings"]
            return
        data_error = "invalid " + DATA_PATH
    else:
        data_error = "missing " + DATA_PATH
    _load_legacy_catalog()


func _load_legacy_catalog() -> void:
    ## Fallback ONLY for a build without the recovered training.list export.
    using_fallback = true
    if not FileAccess.file_exists(LEGACY_CATALOG_PATH):
        push_error("Training data missing and no legacy catalog: " + data_error)
        return
    var parsed: Variant = JSON.parse_string(
        FileAccess.get_file_as_string(LEGACY_CATALOG_PATH))
    if typeof(parsed) != TYPE_DICTIONARY or not parsed.get("entries", null) is Array:
        push_error("Legacy training catalog is invalid")
        return
    var legacy_steps: Array = []
    for entry_value: Variant in Array(parsed["entries"]):
        var entry: Dictionary = entry_value
        var action := String(entry.get("actions", [""])[0])
        legacy_steps.append({
            "index": legacy_steps.size(),
            "input_title_key": null,
            "input_title_text": String(entry.get("label", "")),
            "input_sample": [String(entry.get("input", ""))],
            "input_sequences": [[String(entry.get("input", ""))]],
            "success_animations": [action],
            "success_duration": 0.9,
            "dummy_ai": null,
            "dummy_start_anim": null,
            "dummy_health": null,
            "infinite_rage": true,
            "inmortal_dummy": true,
            "disabled_categories": [],
        })
    trainings = [{
        "index": 0,
        "title_key": "training",
        "title_text": "TRAINING",
        "explanation_key": "",
        "explanation_text": "",
        "menu_option": "training",
        "steps": legacy_steps,
        "legacy": true,
    }]


func _load_ui() -> void:
    _ui = {}
    if not FileAccess.file_exists(UI_PATH):
        return
    var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(UI_PATH))
    if typeof(parsed) == TYPE_DICTIONARY:
        _ui = parsed


func ui_widget(screen: String, widget_name: String) -> Dictionary:
    var screens: Dictionary = _ui.get("screens", {})
    if not screens.has(screen):
        return {}
    for widget: Variant in Array(screens[screen].get("layout", [])):
        if String((widget as Dictionary).get("name", "")) == widget_name:
            return widget
    return {}


func ui_first(screen: String, widget_type: String) -> Dictionary:
    var screens: Dictionary = _ui.get("screens", {})
    if not screens.has(screen):
        return {}
    for widget: Variant in Array(screens[screen].get("layout", [])):
        if String((widget as Dictionary).get("type", "")) == widget_type:
            return widget
    return {}


func _rect(widget: Dictionary, fallback: Rect2) -> Rect2:
    if widget.is_empty():
        return fallback
    return Rect2(
        float(widget.get("x", fallback.position.x)),
        float(widget.get("y", fallback.position.y)),
        float(widget.get("width", fallback.size.x)),
        float(widget.get("height", fallback.size.y)))


func _font_size(role: String, fallback: int) -> int:
    var fonts: Dictionary = _ui.get("fonts", {})
    return int(fonts.get(role, fallback))


func _color8(values, fallback: Color) -> Color:
    if values is Array and Array(values).size() >= 3:
        return Color8(int(values[0]), int(values[1]), int(values[2]),
            int(values[3]) if Array(values).size() >= 4 else 255)
    return fallback


func practice_background_path() -> String:
    var path := OS.get_environment("BRUCELEE_MAINMENU_PATH")
    if path.is_empty():
        var local := OS.get_environment("LOCALAPPDATA")
        if local.is_empty():
            return ""
        path = local.path_join(
            "BruceLee-PC-Port/p5-menu-assets-20261030/mainmenu_default.png")
    return path.get_base_dir().path_join("practice_default.png")


func _training_texture(filename: String) -> Texture2D:
    ## Local-only original training UI art.  A packaged build keeps it loose
    ## beside the executable, so fall back to that directory when res:// has
    ## no imported copy.
    var resource_path := "res://ui/training/" + filename
    if ResourceLoader.exists(resource_path):
        return load(resource_path) as Texture2D
    var loose := OS.get_executable_path().get_base_dir().path_join(
        "ui/training").path_join(filename)
    if not FileAccess.file_exists(loose):
        return null
    var image := Image.load_from_file(loose)
    if image == null or image.is_empty():
        return null
    return ImageTexture.create_from_image(image)



# ------------------------------------------------------------------- UI build

func _build_ui() -> void:
    layer = 24
    process_mode = Node.PROCESS_MODE_ALWAYS
    visible = false

    _background = TextureRect.new()
    _background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    _background.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    _background.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
    _background.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
    _background.mouse_filter = Control.MOUSE_FILTER_IGNORE
    add_child(_background)

    _dim = ColorRect.new()
    _dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    _dim.color = Color(0.0, 0.0, 0.0, 0.45)
    _dim.visible = false
    _dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
    add_child(_dim)

    _frame = Control.new()
    _frame.size = Vector2(REFERENCE_WIDTH, REFERENCE_HEIGHT)
    _frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
    add_child(_frame)

    _build_select_screen()
    _build_intro_screen()
    _build_lesson_screen()
    _build_pause_screen()
    _build_complete_screen()
    _build_free_screen()

    for screen: Control in _screens.values():
        screen.visible = false


func _label(parent: Control, rect: Rect2, text: String, size: int,
        color: Color, align: int = HORIZONTAL_ALIGNMENT_LEFT) -> Label:
    var label := Label.new()
    label.position = rect.position
    label.size = rect.size
    label.text = text
    label.horizontal_alignment = align
    label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    label.mouse_filter = Control.MOUSE_FILTER_IGNORE
    label.add_theme_color_override("font_color", color)
    TrainingText.apply_font(label, size)
    parent.add_child(label)
    return label


func _panel(parent: Control, rect: Rect2) -> Panel:
    var panel := Panel.new()
    panel.position = rect.position
    panel.size = rect.size
    panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
    var style := StyleBoxFlat.new()
    style.bg_color = Color(0.0, 0.0, 0.0, 192.0 / 255.0)
    style.border_color = Color(1.0, 1.0, 1.0, 1.0)
    style.set_border_width_all(1)
    panel.add_theme_stylebox_override("panel", style)
    parent.add_child(panel)
    return panel


func _menu_row(parent: Control, rect: Rect2, text: String, selected: bool,
        size: int) -> Label:
    var color: Color = _color8(
        _ui.get("colors", {}).get("selected", [255, 255, 0]),
        Color(1.0, 1.0, 0.0)) if selected else _color8(
        _ui.get("colors", {}).get("text", [255, 255, 255]), Color.WHITE)
    return _label(parent, rect, text, size, color, HORIZONTAL_ALIGNMENT_CENTER)


func _build_select_screen() -> void:
    var screen := Control.new()
    screen.size = Vector2(REFERENCE_WIDTH, REFERENCE_HEIGHT)
    screen.mouse_filter = Control.MOUSE_FILTER_IGNORE
    _frame.add_child(screen)
    _screens["select"] = screen

    var title_widget := ui_widget("select", "title")
    _title_label = _label(
        screen, _rect(title_widget, Rect2(0, 5, 200, 40)), "",
        _font_size("title", 25), Color.WHITE)
    _title_label.name = "SelectTitle"

    var menu_widget := ui_widget("select", "menu")
    var menu_rect := _rect(menu_widget, Rect2(80, 20, 400, 290))
    var count: int = maxi(selectable_trainings().size(), 1)
    var row_height: float = menu_rect.size.y / float(count)
    for i: int in range(count):
        var row := _menu_row(screen, Rect2(
            menu_rect.position.x, menu_rect.position.y + row_height * i,
            menu_rect.size.x, row_height), "", false, _font_size("menu", 20))
        _select_items.append(row)

    var back_widget := ui_widget("select", "rsk")
    var back_rect := _rect(back_widget, Rect2(2, 270, 48, 48))
    var back := TextureButton.new()
    back.position = back_rect.position
    back.size = back_rect.size
    back.stretch_mode = TextureButton.STRETCH_SCALE
    back.ignore_texture_size = true
    var back_texture := _training_texture("back_button.png")
    if back_texture != null:
        back.texture_normal = back_texture
    back.mouse_filter = Control.MOUSE_FILTER_IGNORE
    screen.add_child(back)


