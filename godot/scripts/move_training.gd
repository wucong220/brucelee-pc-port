# ------------------------------------------------------------- select fighter

func _enter_select_fighter() -> void:
    state = "select_fighter"
    _show_screen("select_fighter")
    var entries := fighter_dock_entries()
    if entries.is_empty():
        _fighter_status.text = "TRAINING FIGHTER DOCK NOT RECOVERED"
        return
    var wanted := current_opponent_key()
    _fighter_index = 0
    for i: int in range(entries.size()):
        if String(entries[i]["opponent"]) == wanted:
            _fighter_index = i
            break
    _refresh_select_fighter()
    _fighter_status.text = ""


func _fighter_step() -> float:
    var dock_widget := ui_widget("select_fighter", "fighters")
    return float(dock_widget.get("optionwidth", 100)) + float(
        dock_widget.get("separation", -16))


func _refresh_select_fighter() -> void:
    var entries := fighter_dock_entries()
    if entries.is_empty():
        return
    _fighter_index = clampi(_fighter_index, 0, entries.size() - 1)
    var entry: Dictionary = entries[_fighter_index]
    _fighter_name.text = String(entry["name"]).to_upper()
    _fighter_fight.add_theme_color_override("font_color",
        _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
            Color(1.0, 1.0, 0.0)) if entry["selectable"] == true
        else Color(0.62, 0.62, 0.62))
    var dock_widget := ui_widget("select_fighter", "fighters")
    var option_width := float(dock_widget.get("optionwidth", 100))
    var step := _fighter_step()
    _fighter_highlight.position = Vector2(_fighter_index * step, 0)
    _fighter_offset = _fighter_dock.size.x * 0.5 - _fighter_index * step \
        - option_width * 0.5
    _fighter_dock_content.position.x = _fighter_offset
    for i: int in range(_fighter_lock_icons.size()):
        _fighter_lock_icons[i].visible = entries[i]["selectable"] != true


func _move_fighter(step: int) -> void:
    var entries := fighter_dock_entries()
    if entries.is_empty():
        return
    _fighter_index = clampi(_fighter_index + step, 0, entries.size() - 1)
    _refresh_select_fighter()
    _fighter_status.text = ""


func _accept_fighter() -> void:
    var entries := fighter_dock_entries()
    if entries.is_empty() or _fighter_index >= entries.size():
        return
    var entry: Dictionary = entries[_fighter_index]
    if not entry["selectable"] == true:
        _fighter_status.text = "NOT AVAILABLE AS A TRAINING OPPONENT"
        return
    var key := String(entry["opponent"])
    if key == current_opponent_key():
        _enter_free()
        return
    # The port cannot swap a candidate after the fighter entered the tree.  The
    # selected key is applied through the same env/reload path as the opponent
    # menu; main.gd reopens free training after the reload.
    free_training_fighter_requested.emit(key)


# --------------------------------------------------------------------- intro

func _enter_intro() -> void:
    _intro_pages = _paginate(explanation_text(current_training))
    _intro_page = 0
    state = "intro"
    _show_screen("intro")
    _refresh_intro()


const INTRO_LINES_PER_PAGE := 3


func _paginate(text: String) -> Array:
    var lines: PackedStringArray = text.split("\n")
    var pages: Array = []
    var page: Array[String] = []
    for line: String in lines:
        page.append(line)
        if page.size() >= INTRO_LINES_PER_PAGE:
            pages.append("\n".join(page))
            page = []
    if not page.is_empty() or pages.is_empty():
        pages.append("\n".join(page))
    return pages


func intro_full_text() -> String:
    return "\n".join(_intro_pages)


func _refresh_intro() -> void:
    if _intro_pages.is_empty():
        _intro_pages = [""]
    _intro_page = clampi(_intro_page, 0, _intro_pages.size() - 1)
    _intro_label.text = String(_intro_pages[_intro_page])
    _intro_page_icon.visible = _intro_pages.size() > 1


func _intro_advance() -> void:
    if _intro_page + 1 < _intro_pages.size():
        _intro_page += 1
        _refresh_intro()
        return
    _begin_lesson_session()


func _begin_lesson_session() -> void:
    if main == null or not main.has_method("begin_training_session"):
        push_error("Training needs main.begin_training_session()")
        return
    main.begin_training_session()
    state = "active"
    current_step_index = 0
    _show_screen("active")
    _start_step(0)


func _enter_free() -> void:
    if main == null or not main.has_method("begin_training_session"):
        return
    main.begin_training_session()
    state = "free"
    _show_screen("free")
    _free_title.text = training_label(current_training)
    _free_panel_label.text = training_label(current_training).to_upper()
    _setup_dummy_stand()


## Entry point for the opponent-switch reload path in main.gd.
func enter_free_training() -> void:
    var selectable := selectable_trainings()
    if selectable.is_empty():
        return
    current_training = selectable[0]
    steps = current_training.get("steps", [])
    _enter_free()


# --------------------------------------------------------------------- lesson

func _start_step(index: int) -> void:
    if steps.is_empty():
        _complete()
        return
    current_step_index = clampi(index, 0, steps.size() - 1)
    current_step = steps[current_step_index]
    success_timer = -1.0
    _prepare_step()
    _refresh_lesson()


func _prepare_step() -> void:
    if player == null or computer == null:
        return
    player.set_physics_process(true)
    player.attack_root_motion_enabled = true
    player.reset_fighter(Vector3(-0.25, 1.20, 0.0))
    player.health = 9999.0
    player.rage = PortFighter.RAGE_MAX if current_step.get("infinite_rage", false) == true else 0.0
    computer.set_physics_process(true)
    computer.reset_fighter(Vector3(0.25, 1.20, 0.0))
    computer.health = 9999.0
    computer.guard_held = false
    computer.collision_layer = 0
    computer.collision_mask = 1
    if _dummy_mode() == "stun":
        computer.state = "stun"
        computer.state_time = 999.0
        computer._animate_candidate()
    if _dummy_mode() == "attack":
        _configure_dummy_ai()


func _setup_dummy_stand() -> void:
    if player == null or computer == null:
        return
    player.set_physics_process(true)
    player.reset_fighter(Vector3(-0.25, 1.20, 0.0))
    player.health = 9999.0
    player.rage = PortFighter.RAGE_MAX
    computer.set_physics_process(true)
    computer.reset_fighter(Vector3(0.25, 1.20, 0.0))
    computer.health = 9999.0
    computer.collision_layer = 0
    computer.collision_mask = 1
    computer.state = "idle"
    computer._animate_candidate()


func _dummy_mode() -> String:
    if _as_text(current_step.get("dummy_start_anim", null)) == "stun":
        return "stun"
    var ai := _as_text(current_step.get("dummy_ai", null))
    if ai.ends_with("training_stun.tree"):
        return "stun"
    if ai.ends_with("training_attack.tree"):
        return "attack"
    return "stand"


func _configure_dummy_ai() -> void:
    if _dummy_ai == null:
        _dummy_ai = TrainingAttackAI.new()
        if not _dummy_ai.load_data():
            push_error("Training attack tree failed to load: " + _dummy_ai.load_error)
            _dummy_ai = null
            return
    _dummy_ai.configure(computer, player, 0xB17E + current_step_index)


func _refresh_lesson() -> void:
    _hud_title.text = training_label(current_training)
    _hud_progress.text = "%02d / %02d" % [
        current_step_index + 1, steps.size()]
    _prompt_label.text = prompt_text()
    _prompt_label.add_theme_color_override("font_color", Color.WHITE)
    _prompt_status.text = ""
    _prompt_status.add_theme_color_override("font_color", Color(0.62, 0.95, 0.62))
    var sequences: Array = current_step.get("input_sequences", [])
    _prompt_page_icon.visible = sequences.size() > 1


func prompt_text() -> String:
    var title := step_title(current_step).to_upper()
    var input := _format_input(current_step)
    if title.is_empty():
        return input
    if input.is_empty():
        return title
    return title + "\n" + input


func _format_input(step: Dictionary) -> String:
    var sequences: Array = step.get("input_sequences", [])
    var lines: Array[String] = []
    for sequence: Variant in sequences:
        var parts: Array[String] = []
        for token: Variant in Array(sequence):
            parts.append(_token_label(String(token)))
        lines.append(" ".join(parts))
    return "\n".join(lines)


func _token_label(token: String) -> String:
    match token:
        "hold":
            return "HOLD"
        "+":
            return "+"
        ",":
            return "THEN"
        "hpunch":
            return "HPUNCH [J]"
        "lpunch":
            return "LPUNCH [K]"
        "hkick":
            return "HKICK [L]"
        "lkick":
            return "LKICK [U]"
        "right":
            return "RIGHT [D]"
        "left":
            return "LEFT [A]"
        "up":
            return "UP [W]"
        "down":
            return "DOWN [S]"
    return token.to_upper()


func _set_hud_visible(value: bool) -> void:
    if main == null:
        return
    var hud = main.get("hud")
    if hud != null:
        hud.visible = value


func _complete() -> void:
    state = "complete"
    success_timer = -1.0
    _show_screen("complete")
    _set_hud_visible(false)
    _complete_title.text = training_label(current_training)
    if player != null:
        player.set_physics_process(false)
    if computer != null:
        computer.set_physics_process(false)


func _advance_step() -> void:
    success_timer = -1.0
    if current_step_index + 1 >= steps.size():
        _complete()
        return
    _start_step(current_step_index + 1)


func _success() -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var duration := float(current_step.get("success_duration", 2.1))
    success_timer = maxf(duration, 0.35)
    _prompt_status.text = "OK"
    _prompt_status.add_theme_color_override("font_color", Color(0.55, 1.0, 0.55))
    _prompt_label.add_theme_color_override("font_color",
        _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
            Color(1.0, 1.0, 0.0)))


# ------------------------------------------------------------------- pause

func _open_pause() -> void:
    _pause_previous = state if state != "pause" else _pause_previous
    state = "pause"
    _pause_index = 0
    _show_screen("pause")
    _set_hud_visible(false)
    _pause_status.text = ""
    _refresh_pause()
    if get_tree() != null:
        get_tree().paused = true


func _refresh_pause() -> void:
    var options := pause_options()
    for i: int in range(_pause_items.size()):
        if i >= options.size():
            _pause_items[i].visible = false
            continue
        _pause_items[i].visible = true
        _pause_items[i].text = TrainingText.text(String(options[i]["label_key"]))
        _pause_items[i].add_theme_color_override("font_color",
            _color8(_ui.get("colors", {}).get("selected", [255, 255, 0]),
                Color(1.0, 1.0, 0.0)) if i == _pause_index
            else _color8(_ui.get("colors", {}).get("text", [255, 255, 255]),
                Color.WHITE))


func _pause_accept() -> void:
    var options := pause_options()
    if _pause_index < 0 or _pause_index >= options.size():
        return
    match String(options[_pause_index]["action"]):
        "resume":
            if get_tree() != null:
                get_tree().paused = false
            state = _pause_previous
            _show_screen(state)
            _set_hud_visible(state == "active" or state == "free")
        "selecttraining":
            if get_tree() != null:
                get_tree().paused = false
            if main != null and main.has_method("end_training_session"):
                main.end_training_session()
            state = "select"
            _show_screen("select")
            _refresh_select()
        "styleeditor":
            style_editor_requested.emit()
        "commands":
            _open_command_list()
        "settings":
            _pause_status.text = "SETTINGS IS NOT RECOVERED FOR TRAINING"
        "mainmenu":
            if get_tree() != null:
                get_tree().paused = false
            close()
            exit_requested.emit()
        _:
            _pause_status.text = "PAUSE OPTION NOT RECOVERED"


# --------------------------------------------------------------- command list

func _open_command_list() -> void:
    state = "command_list"
    _command_offset = 0
    _show_screen("command_list")
    _command_title.text = TrainingText.text("command_list")
    _refresh_command_list()
    if get_tree() != null:
        get_tree().paused = true


func command_list_lines() -> Array[String]:
    var lines: Array[String] = []
    var selectable := selectable_trainings()
    if selectable.is_empty():
        return lines
    for training: Variant in selectable:
        var entry: Dictionary = training
        lines.append("[" + training_label(entry) + "]")
        for step_value: Variant in Array(entry.get("steps", [])):
            var step: Dictionary = step_value
            var title := step_title(step)
            if title.is_empty():
                continue
            var input := _format_input(step).replace("\n", " / ")
            lines.append(title + "  -  " + input)
        lines.append("")
    return lines


func _refresh_command_list() -> void:
    var lines := command_list_lines()
    var per_page := 9
    var maximum := maxi(lines.size() - per_page, 0)
    _command_offset = clampi(_command_offset, 0, maximum)
    var visible: Array[String] = []
    for i: int in range(_command_offset, mini(lines.size(), _command_offset + per_page)):
        visible.append(lines[i])
    _command_label.text = "\n".join(visible)
    _command_title.text = TrainingText.text("command_list") + "  %d/%d" % [
        _command_offset + 1, maxi(lines.size(), 1)]


func _close_command_list() -> void:
    state = "pause"
    _show_screen("pause")
    _refresh_pause()


# --------------------------------------------------------------------- input

func _key_pressed(event: InputEvent, keys: Array) -> bool:
    var key_event: InputEventKey = event as InputEventKey
    if key_event == null or not key_event.pressed or key_event.echo:
        return false
    return key_event.keycode in keys


func _is_up(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MENU_UP)
            or event.is_action_pressed(Controls.MOVE_UP)
            or _key_pressed(event, [KEY_UP, KEY_W]))


func _is_down(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MENU_DOWN)
            or event.is_action_pressed(Controls.MOVE_DOWN)
            or _key_pressed(event, [KEY_DOWN, KEY_S]))


func _is_left(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MOVE_LEFT)
            or _key_pressed(event, [KEY_LEFT, KEY_A]))


func _is_right(event: InputEvent) -> bool:
    return (event.is_action_pressed(Controls.MOVE_RIGHT)
            or _key_pressed(event, [KEY_RIGHT, KEY_D]))


func _input(event: InputEvent) -> void:
    if not visible:
        return
    if handle_input_event(event):
        get_viewport().set_input_as_handled()


func handle_input_event(event: InputEvent) -> bool:
    if not visible or not Controls.is_press_edge(event):
        return false
    match state:
        "practice":
            return _handle_practice_input(event)
        "select":
            return _handle_select_input(event)
        "free_config":
            return _handle_free_config_input(event)
        "select_fighter":
            return _handle_select_fighter_input(event)
        "intro":
            return _handle_intro_input(event)
        "active":
            return _handle_active_input(event)
        "pause":
            return _handle_pause_input(event)
        "command_list":
            return _handle_command_list_input(event)
        "complete":
            return _handle_complete_input(event)
        "free":
            if event.is_action_pressed(Controls.PAUSE) \
                    or event.is_action_pressed(Controls.MENU_CANCEL):
                _open_pause()
                return true
    return false


func _handle_practice_input(event: InputEvent) -> bool:
    if _is_up(event):
        _move_practice(-1)
        return true
    if _is_down(event):
        _move_practice(1)
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _accept_practice()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        close()
        exit_requested.emit()
        return true
    return false


func _handle_select_input(event: InputEvent) -> bool:
    if _is_up(event):
        _move_selection(-1)
        return true
    if _is_down(event):
        _move_selection(1)
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _accept_selected()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        state = "practice"
        _show_screen("practice")
        _refresh_practice()
        return true
    return false


func _handle_free_config_input(event: InputEvent) -> bool:
    if _is_up(event):
        _free_config_index = maxi(_free_config_index - 1, 0)
        _refresh_free_config()
        return true
    if _is_down(event):
        _free_config_index = mini(
            _free_config_index + 1, maxi(free_config_options().size() - 1, 0))
        _refresh_free_config()
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _accept_free_config()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        state = "select"
        _show_screen("select")
        _refresh_select()
        return true
    return false


func _handle_select_fighter_input(event: InputEvent) -> bool:
    if _is_left(event):
        _move_fighter(-1)
        return true
    if _is_right(event):
        _move_fighter(1)
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _accept_fighter()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        state = "free_config"
        _show_screen("free_config")
        _refresh_free_config()
        return true
    return false


func _handle_intro_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _intro_advance()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        state = "select"
        _show_screen("select")
        _refresh_select()
        return true
    return false


func _handle_active_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.PAUSE):
        _open_pause()
        return true
    if event.is_action_pressed(Controls.RESTART):
        _start_step(current_step_index)
        return true
    if event.is_action_pressed(Controls.MOVE_RIGHT):
        _note_tap("right")
        return false
    if event.is_action_pressed(Controls.MOVE_LEFT):
        _note_tap("left")
        return false
    return false


func _note_tap(direction: String) -> void:
    if player == null:
        return
    var now := Time.get_ticks_msec()
    var last := int(_last_tap.get(direction, -1))
    _last_tap[direction] = now
    if last >= 0 and now - last <= 320:
        if direction == "right":
            player.request_skip("skipfwd")
        else:
            player.request_skip("skipback")
        _last_tap[direction] = -1


func _handle_pause_input(event: InputEvent) -> bool:
    if _is_up(event):
        _pause_index = wrapi(_pause_index - 1, 0, _pause_items.size())
        _pause_status.text = ""
        _refresh_pause()
        return true
    if _is_down(event):
        _pause_index = wrapi(_pause_index + 1, 0, _pause_items.size())
        _pause_status.text = ""
        _refresh_pause()
        return true
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        _pause_accept()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        if get_tree() != null:
            get_tree().paused = false
        state = _pause_previous
        _show_screen(state)
        _set_hud_visible(state == "active" or state == "free")
        return true
    return false


func _handle_command_list_input(event: InputEvent) -> bool:
    if _is_up(event):
        _command_offset = maxi(_command_offset - 1, 0)
        _refresh_command_list()
        return true
    if _is_down(event):
        _command_offset += 1
        _refresh_command_list()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE) \
            or event.is_action_pressed(Controls.MENU_ACCEPT):
        _close_command_list()
        return true
    return false


func _handle_complete_input(event: InputEvent) -> bool:
    if event.is_action_pressed(Controls.MENU_ACCEPT):
        if main != null and main.has_method("end_training_session"):
            main.end_training_session()
        state = "select"
        _show_screen("select")
        _refresh_select()
        return true
    if event.is_action_pressed(Controls.MENU_CANCEL) \
            or event.is_action_pressed(Controls.PAUSE):
        close()
        exit_requested.emit()
        return true
    return false


# --------------------------------------------------------------- per frame

func _process(delta: float) -> void:
    if visible:
        _layout_frame()
    if _notice.visible:
        _notice_timer -= delta
        if _notice_timer <= 0.0:
            _notice.visible = false
    if state != "active" or player == null or computer == null:
        return
    _keep_fighters_alive()
    _drive_dummy(delta)
    if success_timer >= 0.0:
        success_timer -= delta
        if success_timer <= 0.0:
            _advance_step()
        return
    var action := _player_native_action()
    if not action.is_empty() \
            and action in Array(current_step.get("success_animations", [])):
        _success()


func _keep_fighters_alive() -> void:
    player.health = 9999.0
    if current_step.get("infinite_rage", false) == true:
        player.rage = PortFighter.RAGE_MAX
    var dummy_health: Variant = current_step.get("dummy_health", null)
    if dummy_health == null:
        computer.health = 9999.0
    else:
        computer.health = float(dummy_health)
    if _dummy_mode() != "stun" and computer.state in [
            "ko", "facedownko", "faceupko", "facedownidle", "faceupidle"]:
        computer.state = "idle"
        computer.attack_kind = ""
        computer._animate_candidate()


func _drive_dummy(delta: float) -> void:
    var mode := _dummy_mode()
    if mode == "stun":
        if computer.state not in [
                "stun", "stun2", "stunfall", "impactstun", "stunimpact",
                "hitstun", "grabbed1", "grabbed2"]:
            computer.state = "stun"
            computer.state_time = 999.0
            computer.attack_kind = ""
            computer._animate_candidate()
        return
    if mode == "attack":
        if computer.state in ["idle2", "idle3"]:
            computer.state = "idle"
        if _dummy_ai == null:
            _configure_dummy_ai()
        if _dummy_ai != null:
            _dummy_ai.step(delta)
        return
    if computer.state in ["idle2", "idle3"]:
        computer.state = "idle"


func _player_native_action() -> String:
    if player.attack_kind != "" and player.state in ["startup", "active", "recovery"]:
        var row: Dictionary = player.ATTACKS.get(player.attack_kind, {})
        var source := String(row.get("source_action", ""))
        if not source.is_empty():
            return source
        return player.attack_kind
    var current := String(player._current_action_name())
    if current in MOVEMENT_ACTIONS:
        return current
    var locomotion := String(player._locomotion_action)
    if locomotion in MOVEMENT_ACTIONS:
        return locomotion
    if player._skip_time > 0.0:
        return String(player._skip_action)
    return ""


# --------------------------------------------------------------- signals

func _on_attack_started(action: String) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var source := action
    var row: Dictionary = player.ATTACKS.get(action, {})
    if row.has("source_action"):
        source = String(row["source_action"])
    if source in Array(current_step.get("success_animations", [])):
        _success()


func _on_combat_hit(attacker: PortFighter, defender: PortFighter, action: String,
        _damage: float, blocked: bool) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    if defender != player or not blocked:
        return
    var animations: Array = current_step.get("success_animations", [])
    for block_action: String in BLOCK_ACTIONS:
        if block_action in animations:
            _success()
            return


func _on_parry_succeeded(action: String) -> void:
    if state != "active" or success_timer >= 0.0:
        return
    var source := action
    var row: Dictionary = player.ATTACKS.get(action, {})
    if row.has("source_action"):
        source = String(row["source_action"])
    var animations: Array = current_step.get("success_animations", [])
    if source in animations or action in animations:
        _success()


## Called by main.gd after the Style Editor closes so the pause menu refreshes
## its recovered options without leaving the paused lesson.
func on_style_editor_closed() -> void:
    if state == "pause":
        _refresh_pause()
    elif state == "practice":
        _refresh_practice()
