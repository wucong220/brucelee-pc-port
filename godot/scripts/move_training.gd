extends CanvasLayer
class_name PortMoveTraining

## Recovered native training screens (training.list + the shipped .ui layouts).
##
## Flow (all options read from `res://data/training_native.json` /
## `res://data/training_ui.json`, generated by `tools/build_training_data.py`
## from the untouched data.zpak):
##
##   practice menu (trainingmenu.ui)
##     Training       -> select (selecttraining.ui, 7 recovered entries)
##                        Free Training -> free config (freetrainingconfig.ui)
##                                         -> fighter dock (trainingselectfighter.ui)
##                                         -> sandbox
##                        lessons -> introduction (trainingintroduction.ui)
##                                -> steps -> completion
##     Style Editor   -> the existing opt-in Style Editor screen
##
##   ESC in a lesson -> pause (trainingpause.ui, all six recovered options)
##
## No lesson text is invented.  The eighth training entry in training.list has
## no recovered menu binding (selecttraining.ui has exactly seven options), so it
## stays in the data and is never exposed: `unbound_trainings()` reports it and
## the select list only renders `selectable_trainings()`.

signal exit_requested
signal style_editor_requested
signal free_training_fighter_requested(opponent_key: String)

